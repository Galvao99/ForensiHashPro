# O ForensiHash lê estas variáveis do ambiente do processo.
# Este arquivo é somente referência; ele não é carregado automaticamente.
IP2LOCATION_API_KEY=
IP2LOCATION_ENABLED=false

# Caminhos opcionais. Deixe vazio para autodetecção.
FORENSIHASH_CONFIG_DIR=
FORENSIHASH_TEMP_DIR=
FORENSIHASH_EXIFTOOL_PATH=
FORENSIHASH_TESSERACT_PATH=
FORENSIHASH_POPPLER_PATH=

# Recursos opcionais.
FORENSIHASH_OCR_ENABLED=true
FORENSIHASH_METADATA_ENABLED=true
FORENSIHASH_RUST_JSON_ENABLED=true
