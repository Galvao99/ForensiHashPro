FORENSIHASH_DATABASE_URL=postgresql+psycopg://forensihash:local-only@localhost:5432/forensihash
FORENSIHASH_DATABASE_CONNECT_TIMEOUT=5
FORENSIHASH_SESSION_SECRET=replace-with-at-least-32-random-characters
FORENSIHASH_COOKIE_SECURE=false
FORENSIHASH_COOKIE_SAMESITE=lax
FORENSIHASH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FORENSIHASH_REGISTRATION_ENABLED=true
FORENSIHASH_JOB_WORKER_ENABLED=true
FORENSIHASH_ANALYSIS_CONCURRENCY=1
FORENSIHASH_ANALYSIS_QUEUE_CAPACITY=20
FORENSIHASH_ANALYSIS_TIMEOUT_SECONDS=300
FORENSIHASH_ARCHIVE_MAX_ENTRIES=1000
FORENSIHASH_ARCHIVE_MAX_TOTAL_UNCOMPRESSED_BYTES=1073741824
FORENSIHASH_ARCHIVE_MAX_ENTRY_UNCOMPRESSED_BYTES=268435456
FORENSIHASH_ARCHIVE_MAX_COMPRESSION_RATIO=200
FORENSIHASH_ARCHIVE_MAX_NESTING_DEPTH=3
FORENSIHASH_ARCHIVE_INSPECTION_TIMEOUT_SECONDS=30
FORENSIHASH_ENV=development
POSTGRES_PASSWORD=local-only
POSTGRES_HOST_PORT=5432
