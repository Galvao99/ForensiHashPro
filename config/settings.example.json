{
    "ip_provider": "ip2location",
    "ip_lookup_enabled": false,
    "request_timeout": 15,
    "ocr_enabled": true,
    "metadata_enabled": true,
    "rust_json_enabled": true,
    "limits": {
        "max_file_size_bytes": 2147483648,
        "max_pdf_pages": 1000,
        "max_image_width": 30000,
        "max_image_height": 30000,
        "max_image_pixels": 100000000,
        "max_estimated_memory_bytes": 1073741824,
        "ocr_timeout_seconds": 120,
        "external_tool_timeout_seconds": 60,
        "max_external_output_bytes": 10485760,
        "max_pdf_objects": 1000000,
        "max_binary_strings": 1000,
        "max_archive_depth": 10,
        "max_archive_entries": 10000,
        "max_expanded_bytes": 4294967296
    }
}
