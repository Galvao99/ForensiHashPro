/* =========================================================
   FORENSIHASH PRO - CLEAN DARK THEME
   Tipografia consolidada e duplicidades removidas
   ========================================================= */

/* =========================
   GLOBAL
   ========================= */
QWidget {
    background-color: #0B1120;
    color: #E5E7EB;
    font-family: "Segoe UI", "Inter", "Arial";
    font-size: 13px;
}

QLabel {
    background: transparent;
}

#Content,
QWidget#TimelinePage {
    background-color: #0B1120;
}

#PageTitle {
    font-size: 28px;
    font-weight: 900;
    color: #F8FAFC;
}

#SectionTitle {
    font-size: 22px;
    font-weight: 900;
    color: #F8FAFC;
}

#SectionSubtitle {
    font-size: 13px;
    color: #94A3B8;
}

#ClockLabel {
    color: #60A5FA;
    font-size: 12px;
    font-weight: 600;
}

/* =========================================================
   SIDEBAR — ESTRUTURA PRINCIPAL
   ========================================================= */

/*
   Define o painel lateral completo.
*/
QFrame#Sidebar {

    /* Cor principal do fundo da sidebar. */
    background-color: #070D1D;

    /* Linha discreta entre sidebar e conteúdo. */
    border-right: 1px solid #1D2A42;
}


/*
   Remove fundos adicionais dos painéis internos.
   Isso evita retângulos com cores diferentes.
*/
QWidget#SidebarBrand,
QWidget#SidebarFilePanel,
QWidget#SidebarAnalysisPanel,
QWidget#SidebarFileHeader,
QWidget#SidebarNavigationContainer {

    /* Mantém o mesmo fundo da sidebar. */
    background: transparent;

    /* Remove bordas herdadas. */
    border: none;
}


/* =========================================================
   MARCA
   ========================================================= */

/*
   Nome principal do aplicativo.
*/
QLabel#SidebarTitle {

    /* Cor clara do nome. */
    color: #F8FAFC;

    /* Tamanho da fonte. */
    font-size: 15px;

    /* Peso visual. */
    font-weight: 700;
}


/*
   Texto PRO abaixo da marca.
*/
QLabel#SidebarSubtitle {

    /* Cor azul da identidade visual. */
    color: #38BDF8;

    /* Tamanho reduzido. */
    font-size: 11px;

    /* Peso forte. */
    font-weight: 800;

    /* Espaçamento entre letras. */
    letter-spacing: 1px;
}


/* =========================================================
   TÍTULOS DAS SEÇÕES
   ========================================================= */

/*
   Estilo utilizado nos títulos:
   CASO, ARQUIVOS, ANÁLISE e FERRAMENTAS.
*/
QLabel#SidebarSectionTitle {

    /* Cor secundária clara. */
    color: #A7B4C9;

    /* Tamanho compacto. */
    font-size: 11px;

    /* Peso médio. */
    font-weight: 700;

    /* Espaçamento entre letras. */
    letter-spacing: 1px;

    /* Pequeno espaço interno lateral. */
    padding: 2px 2px;
}


/* =========================================================
   BOTÕES DE AÇÃO
   ========================================================= */

/*
   Botões:
   - Abrir arquivo;
   - Abrir pasta;
   - Exportar.
*/
QPushButton#SidebarActionButton {

    /* Altura mínima confortável. */
    min-height: 40px;

    /* Espaçamento interno horizontal. */
    padding: 0 12px;

    /* Alinha o conteúdo à esquerda. */
    text-align: left;

    /* Fundo padrão do botão. */
    background-color: #10192C;

    /* Borda discreta. */
    border: 1px solid #202E49;

    /* Arredondamento. */
    border-radius: 9px;

    /* Cor do texto. */
    color: #D7E2F5;

    /* Tamanho da fonte. */
    font-size: 13px;

    /* Peso da fonte. */
    font-weight: 700;
}


/*
   Estado quando o mouse passa sobre
   um botão de ação.
*/
QPushButton#SidebarActionButton:hover {

    /* Clareia levemente o fundo. */
    background-color: #17233A;

    /* Reforça a borda. */
    border-color: #31507C;

    /* Clareia o texto. */
    color: #FFFFFF;
}


/*
   Estado durante o clique.
*/
QPushButton#SidebarActionButton:pressed {

    /* Fundo azul discreto. */
    background-color: #1D355C;

    /* Borda azul. */
    border-color: #3B82F6;
}


/* =========================================================
   SEPARADORES HORIZONTAIS
   ========================================================= */

/*
   Linha horizontal usada entre grupos.
*/
QFrame#SidebarSeparator {

    /* Altura fixa de um pixel. */
    min-height: 1px;
    max-height: 1px;

    /* Cor da linha. */
    background-color: #1D2A42;

    /* Remove borda própria do frame. */
    border: none;

    /* Espaçamento acima. */
    margin-top: 3px;

    /* Espaçamento abaixo. */
    margin-bottom: 3px;
}


/* =========================================================
   DIVISOR AJUSTÁVEL
   ========================================================= */

/*
   Componente que divide:
   - navegador de arquivos;
   - menu de análise.
*/
QSplitter#SidebarContentSplitter {

    /* Fundo transparente para não criar outro painel. */
    background: transparent;

    /* Remove bordas. */
    border: none;
}


/*
   Barra que o usuário arrasta
   para redimensionar os painéis.
*/
QSplitter#SidebarContentSplitter::handle {

    /* Espessura vertical da área arrastável. */
    height: 7px;

    /* Fundo transparente por padrão. */
    background: transparent;

    /* Linha central discreta. */
    border-top: 1px solid #26344D;

    /* Linha inferior discreta. */
    border-bottom: 1px solid transparent;
}


/*
   Destaque do divisor quando o mouse passa.
*/
QSplitter#SidebarContentSplitter::handle:hover {

    /* Azul discreto indicando que é ajustável. */
    border-top-color: #3B82F6;

    /* Pequeno realce de fundo. */
    background-color: rgba(59, 130, 246, 0.06);
}


/* =========================================================
   CONTADOR DE ARQUIVOS
   ========================================================= */

/*
   Badge que mostra a quantidade
   de arquivos carregados.
*/
QLabel#SidebarFileCount {

    /* Largura mínima. */
    min-width: 24px;

    /* Largura máxima. */
    max-width: 42px;

    /* Altura mínima. */
    min-height: 22px;

    /* Altura máxima. */
    max-height: 22px;

    /* Espaçamento horizontal interno. */
    padding: 0 6px;

    /* Fundo azul translúcido. */
    background-color: rgba(59, 130, 246, 0.16);

    /* Cor do número. */
    color: #93C5FD;

    /* Borda azul discreta. */
    border: 1px solid rgba(59, 130, 246, 0.28);

    /* Arredondamento. */
    border-radius: 7px;

    /* Tamanho da fonte. */
    font-size: 11px;

    /* Peso forte. */
    font-weight: 800;
}


/* =========================================================
   PESQUISA DE ARQUIVOS
   ========================================================= */

/*
   Campo utilizado para filtrar
   os arquivos pelo nome.
*/
QLineEdit#SidebarFileSearch {

    /* Altura mínima. */
    min-height: 34px;

    /* Altura máxima. */
    max-height: 34px;

    /* Espaçamento interno. */
    padding: 0 10px;

    /* Fundo discreto. */
    background-color: #0E1728;

    /* Cor do texto digitado. */
    color: #E5E7EB;

    /* Borda padrão. */
    border: 1px solid #25334D;

    /* Arredondamento. */
    border-radius: 8px;

    /* Tamanho da fonte. */
    font-size: 12px;
}


/*
   Campo quando o mouse passa.
*/
QLineEdit#SidebarFileSearch:hover {

    /* Reforça levemente a borda. */
    border-color: #36557F;
}


/*
   Campo quando recebe foco.
*/
QLineEdit#SidebarFileSearch:focus {

    /* Borda azul de foco. */
    border-color: #3B82F6;
}


/*
   Texto exibido antes da digitação.
*/
QLineEdit#SidebarFileSearch::placeholder {

    /* Cor mais suave. */
    color: #64748B;
}


/* =========================================================
   LISTA DE ARQUIVOS
   ========================================================= */

/*
   Estrutura externa da lista.
*/
QListWidget#SidebarFileList {

    /* Fundo integrado à sidebar. */
    background: transparent;

    /* Remove borda externa. */
    border: none;

    /* Remove arredondamento externo. */
    border-radius: 0;

    /* Remove espaço interno desnecessário. */
    padding: 0;

    /* Remove contorno padrão de foco. */
    outline: none;

    /* Tamanho da fonte. */
    font-size: 12px;
}


/*
   Cada linha da lista de arquivos.
*/
QListWidget#SidebarFileList::item {

    /* Altura necessária para nome e detalhes. */
    min-height: 64px;

    /* Remove margens externas. */
    margin: 0;

    /* Remove preenchimento do QListWidgetItem. */
    padding: 0;

    /* Fundo padrão transparente. */
    background: transparent;

    /* Borda transparente para impedir mudanças de tamanho. */
    border: 1px solid transparent;

    /* Arredondamento visual. */
    border-radius: 10px;
}


/*
   Arquivo quando o mouse passa sobre ele.
*/
QListWidget#SidebarFileList::item:hover {

    /* Fundo de destaque somente no hover. */
    background-color: rgba(59, 130, 246, 0.08);

    /* Borda muito discreta. */
    border-color: rgba(59, 130, 246, 0.20);
}


/*
   Arquivo selecionado.
*/
QListWidget#SidebarFileList::item:selected {

    /* Fundo discreto para indicar seleção. */
    background-color: rgba(59, 130, 246, 0.12);

    /* Linha lateral azul. */
    border-left: 2px solid #3B82F6;

    /* Outras bordas permanecem transparentes. */
    border-top-color: transparent;
    border-right-color: transparent;
    border-bottom-color: transparent;

    /* Cor clara do texto. */
    color: #FFFFFF;
}


/*
   Widget interno de cada arquivo.
*/
QWidget#SidebarFileItemWidget {

    /* Não cria outro retângulo por cima do item. */
    background: transparent;

    /* Remove qualquer borda interna. */
    border: none;
}


/*
   Badge PDF, IMG, DOC, ZIP ou TXT.
*/
QLabel#SidebarFileTypeIcon {

    /* Fundo azul escuro. */
    background-color: #17233A;

    /* Cor do texto. */
    color: #8FB7ED;

    /* Borda discreta. */
    border: 1px solid #2A3D5D;

    /* Arredondamento. */
    border-radius: 8px;

    /* Fonte compacta. */
    font-size: 9px;

    /* Peso forte. */
    font-weight: 900;
}


/*
   Nome principal do arquivo.
*/
QLabel#SidebarFileName {

    /* Fundo transparente. */
    background: transparent;

    /* Remove borda. */
    border: none;

    /* Cor principal. */
    color: #E8EEF8;

    /* Tamanho da fonte. */
    font-size: 12px;

    /* Peso da fonte. */
    font-weight: 700;
}


/*
   Extensão e tamanho do arquivo.
*/
QLabel#SidebarFileDetails {

    /* Fundo transparente. */
    background: transparent;

    /* Remove borda. */
    border: none;

    /* Cor secundária. */
    color: #71839F;

    /* Tamanho menor. */
    font-size: 10px;

    /* Peso médio. */
    font-weight: 600;
}


/* =========================================================
   NAVEGAÇÃO DAS ANÁLISES
   ========================================================= */

/*
   Scroll que contém os botões técnicos.
*/
QScrollArea#SidebarNavigationScroll {

    /* Fundo transparente. */
    background: transparent;

    /* Remove borda. */
    border: none;
}


/*
   Remove fundos criados pelo viewport
   interno do QScrollArea.
*/
QScrollArea#SidebarNavigationScroll > QWidget > QWidget {

    /* Mantém integração com a sidebar. */
    background: transparent;

    /* Remove bordas. */
    border: none;
}


/*
   Botões:
   Geral, Hashes, Metadados, Vestígios etc.
*/
QPushButton#SidebarNavigationButton {

    /* Altura suficiente para leitura. */
    min-height: 38px;

    /* Remove o fundo de cartão. */
    background: transparent;

    /* Remove todas as bordas. */
    border: none;

    /* Pequeno arredondamento usado no hover. */
    border-radius: 7px;

    /* Alinha o conteúdo à esquerda. */
    text-align: left;

    /* Remove preenchimento global de QPushButton. */
    padding: 0;
}


/*
   Botão de análise quando o mouse passa.
*/
QPushButton#SidebarNavigationButton:hover {

    /* Único fundo de destaque forte. */
    background-color: rgba(59, 130, 246, 0.10);

    /* Continua sem bordas. */
    border: none;
}


/*
   Página atualmente selecionada.
*/
QPushButton#SidebarNavigationButton:checked {

    /* Evita o retângulo preenchido. */
    background: transparent;

    /* Pequena linha azul à esquerda. */
    border-left: 2px solid #3B82F6;

    /* Remove as demais bordas. */
    border-top: none;
    border-right: none;
    border-bottom: none;
}


/*
   Página selecionada com mouse sobre ela.
*/
QPushButton#SidebarNavigationButton:checked:hover {

    /* Mantém o destaque do hover. */
    background-color: rgba(59, 130, 246, 0.10);

    /* Preserva a linha lateral. */
    border-left: 2px solid #3B82F6;
}


/*
   Ícone dos botões técnicos.
*/
QLabel#SidebarNavigationIcon {

    /* Cor padrão suave. */
    color: #7691BD;

    /* Tamanho do ícone textual. */
    font-size: 14px;

    /* Peso da fonte. */
    font-weight: 700;

    /* Fundo transparente. */
    background: transparent;

    /* Remove borda. */
    border: none;
}


/*
   Texto dos botões técnicos.
*/
QLabel#SidebarNavigationText {

    /* Cor padrão. */
    color: #C4D0E4;

    /* Tamanho da fonte. */
    font-size: 13px;

    /* Peso médio. */
    font-weight: 600;

    /* Fundo transparente. */
    background: transparent;

    /* Remove borda. */
    border: none;
}


/*
   Ícone da página selecionada.
*/
QPushButton#SidebarNavigationButton:checked QLabel#SidebarNavigationIcon {

    /* Azul de destaque. */
    color: #60A5FA;
}


/*
   Texto da página selecionada.
*/
QPushButton#SidebarNavigationButton:checked QLabel#SidebarNavigationText {

    /* Texto claro. */
    color: #FFFFFF;

    /* Reforça o peso. */
    font-weight: 700;
}


/*
   Ícone no hover.
*/
QPushButton#SidebarNavigationButton:hover QLabel#SidebarNavigationIcon {

    /* Clareia o ícone. */
    color: #93C5FD;
}


/*
   Texto no hover.
*/
QPushButton#SidebarNavigationButton:hover QLabel#SidebarNavigationText {

    /* Clareia o texto. */
    color: #FFFFFF;
}


/* =========================================================
   WORKSPACE
   ========================================================= */

QStackedWidget#AnalysisWorkspace {
    background: transparent;
}

QLabel#WorkspaceContextLabel {
    color: #71819c;
    font-size: 12px;
}

QFrame#AnalysisProgressContainer {
    background-color: rgba(17, 26, 45, 0.75);
    border: 1px solid #1d2a42;
    border-radius: 9px;
}

QLabel#AnalysisStatusLabel {
    color: #8495b3;
    font-size: 11px;
}

QProgressBar{

    min-height:10px;
    max-height:10px;
    border:none;
    border-radius:5px;
    background:#1E2A40;

}

QProgressBar::chunk{

    border-radius:5px;
    background:#3B82F6;

}


/* =========================================================
   HOME
   ========================================================= */

QFrame#HomeHeroCard {
    background-color: #111a2d;
    border: 1px solid #23324e;
    border-radius: 16px;
}

QLabel#HomeHeroBadge {
    color: #46b9ff;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 2px;
}

QLabel#HomeHeroTitle {
    color: #f3f7ff;
    font-size: 31px;
    font-weight: 800;
}

QLabel#HomeHeroSubtitle {
    color: #91a0b8;
    font-size: 13px;
}

QPushButton#HomePrimaryButton,
QPushButton#HomeSecondaryButton {
    min-height: 42px;
    padding: 0 18px;
    border-radius: 9px;
    font-size: 13px;
    font-weight: 700;
}

QPushButton#HomePrimaryButton {
    background-color: #2563eb;
    border: 1px solid #3b82f6;
    color: white;
}

QPushButton#HomePrimaryButton:hover {
    background-color: #3274f4;
}

QPushButton#HomeSecondaryButton {
    background-color: #151f34;
    border: 1px solid #2a3a59;
    color: #d8e3f6;
}

QPushButton#HomeSecondaryButton:hover {
    background-color: #1b2942;
}

QFrame#HomeInfoCard {
    background-color: #101829;
    border: 1px solid #202d46;
    border-radius: 14px;
}

QLabel#HomeCardTitle {
    color: #edf3ff;
    font-size: 16px;
    font-weight: 700;
}

QLabel#HomeInstructionNumber {
    border-radius: 8px;
    background-color: rgba(59, 130, 246, 0.16);
    color: #7fb5ff;
    font-size: 13px;
    font-weight: 700;
}

QLabel#HomeInstructionTitle {
    color: #dce6f7;
    font-size: 13px;
    font-weight: 700;
}

QLabel#HomeInstructionDescription,
QLabel#HomeWorkspaceDetails {
    color: #7889a6;
    font-size: 12px;
}

QLabel#HomeWorkspaceStatus {
    color: #dce6f7;
    font-size: 14px;
    font-weight: 700;
}

/* =========================
   BUTTONS
   ========================= */
QPushButton {
    background-color: #0F172A;
    color: #CBD5E1;
    border: 1px solid #1E293B;
    border-radius: 12px;
    padding: 11px 14px;
    text-align: left;
    font-weight: 700;
}

QPushButton:hover {
    background-color: #172554;
    color: #FFFFFF;
    border-color: #2563EB;
}

QPushButton:pressed {
    background-color: #1D4ED8;
    border-color: #60A5FA;
}

/* =========================
   TABS
   ========================= */
QTabWidget::pane {
    border: 1px solid #1E293B;
    border-radius: 18px;
    background-color: #0F172A;
    top: -1px;
}

QTabBar::tab {
    background-color: #0F172A;
    color: #94A3B8;
    border: 1px solid #1E293B;
    padding: 11px 18px;
    margin-right: 5px;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    font-weight: 700;
}

QTabBar::tab:selected {
    background-color: #2563EB;
    color: #FFFFFF;
    border-color: #60A5FA;
}

QTabBar::tab:hover:selected {
    background-color: #172554;
    color: #E0F2FE;
}

/* QTabBar::tab:hover:!selected {
    background-color: #172554;
    color: #E0F2FE;
} */

/* =========================
   BASE CARDS
   ========================= */
#BaseCard,
#InfoCard,
#summaryCard,
#metadataCard,
#findingsPreviewCard {
    background-color: #111827;
    border: 1px solid #243244;
    border-radius: 18px;
    padding: 16px;
}

#BaseCard:hover,
#InfoCard:hover,
#summaryCard:hover,
#metadataCard:hover,
#findingsPreviewCard:hover {
    border-color: #334155;
}

#CardTitle,
#DashboardTitle,
#summaryTitle,
#metadataCardTitle,
#findingsPreviewTitle {
    color: #F8FAFC;
    font-weight: 900;
}

#CardContent,
#summaryText,
#metadataHighlightText,
#metadataInsightText,
#findingsPreviewText {
    color: #CBD5E1;
}

/* =========================
   LISTS / TABLES
   ========================= */
QListWidget,
QTableWidget {
    background-color: #0F172A;
    color: #E5E7EB;
    border: 1px solid #1E293B;
    border-radius: 14px;
    padding: 8px;
    gridline-color: #1E293B;
    selection-background-color: #2563EB;
    selection-color: #FFFFFF;
}

QListWidget::item {
    padding: 8px;
    border-radius: 8px;
}

QListWidget::item:hover {
    background-color: #1E293B;
}

QListWidget::item:selected {
    background-color: #2563EB;
    color: #FFFFFF;
}

QTableWidget::item {
    padding: 8px;
}

QTableWidget::item:hover {
    background-color: #1E293B;
}

QHeaderView::section {
    background-color: #111827;
    color: #F8FAFC;
    border: none;
    padding: 9px;
    font-weight: 800;
}

/* =========================
   INPUTS
   ========================= */
QLineEdit,
QDateTimeEdit,
QComboBox,
#HashSelector {
    background-color: #0B1220;
    color: #E5E7EB;
    border: 1px solid #1E293B;
    border-radius: 10px;
    padding: 8px 12px;
}

QLineEdit:focus,
QDateTimeEdit:focus,
QComboBox:hover,
#HashSelector:hover {
    border-color: #38BDF8;
}

QLineEdit::placeholder {
    color: #64748B;
}

/* =========================
   SCROLL
   ========================= */
QScrollArea,
#MainScrollArea,
#FindingScrollArea,
#TimelineScroll {
    border: none;
    background: transparent;
}

QScrollBar:vertical {
    background: #0F172A;
    width: 12px;
    margin: 4px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background: #334155;
    min-height: 40px;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background: #475569;
}

QScrollBar:horizontal {
    background: #0F172A;
    height: 12px;
    margin: 4px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background: #334155;
    min-width: 40px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal:hover {
    background: #475569;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0px;
    height: 0px;
}

/* =========================
   SMART TIMELINE
   ========================= */
QWidget#SmartTimeline {
    background-color: #0F172A;
    border: 1px solid #243244;
    border-radius: 16px;
    min-height: 155px;
}

QFrame#SmartTimelineTrack {
    background-color: #334155;
    border: none;
    margin-left: 45px;
    margin-right: 45px;
}

QWidget#TimelineNode {
    background: transparent;
}

QLabel#TimelineNodeDot {
    font-size: 18px;
    font-weight: 900;
}

QFrame#TimelineNodeLine {
    background-color: #475569;
    border: none;
    min-width: 2px;
    max-width: 2px;
}

QLabel#TimelineNodeTitle {
    color: #F8FAFC;
    font-size: 12px;
    font-weight: 800;
}

QLabel#TimelineNodeDate {
    color: #BFDBFE;
    font-size: 11px;
    font-weight: 600;
}

/* =========================
   TECHNICAL TIMELINE CARDS
   ========================= */
QWidget#TechnicalTimeline {
    background: transparent;
}

QFrame#TimelineEventCard {
    background-color: #111827;
    border: 1px solid #243244;
    border-radius: 16px;
    min-height: 190px;
}

QFrame#TimelineEventCard:hover {
    background-color: #162033;
    border-color: #3B82F6;
}

QLabel#TimelineCardDot {
    font-size: 22px;
    font-weight: 900;
}

QLabel#TimelineCardTitle {
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 800;
}

QLabel#TimelineCardDate {
    color: #BFDBFE;
    font-size: 12px;
    font-weight: 600;
}

QLabel#TimelineCardSource {
    color: #DBEAFE;
    background-color: #0B1222;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 5px 8px;
    font-size: 11px;
}

QLabel#TimelineCardDescription {
    color: #CBD5E1;
    font-size: 12px;
}

QLabel#TimelineResult {
    color: #FBBF24;
    background-color: rgba(251, 146, 60, 0.10);
    border: 1px solid rgba(251, 146, 60, 0.35);
    border-radius: 12px;
    padding: 12px;
    font-size: 12px;
}

/* =========================
   CONTRACT DATE CONFIRMATION
   ========================= */
QFrame#ContractDateConfirmationCard {
    background-color: #111C33;
    border: 1px solid #F59E0B;
    border-radius: 14px;
}

QLabel#ContractDateTitle {
    color: #FBBF24;
    font-size: 15px;
    font-weight: 800;
}

QLabel#ContractDateMessage {
    color: #CBD5E1;
    font-size: 13px;
}

/* =========================
   SUMMARY / PROGRESS
   ========================= */
QProgressBar {
    background-color: #1E293B;
    border: none;
    border-radius: 6px;
    color: #F8FAFC;
    text-align: center;
    height: 22px;
    font-weight: 800;
}

QProgressBar::chunk {
    background-color: #2563EB;
    border-radius: 6px;
}

#summaryScoreOk {
    color: #86EFAC;
    font-weight: 900;
}

#summaryScoreWarning {
    color: #FDE68A;
    font-weight: 900;
}

#summaryScoreDanger {
    color: #FDA4AF;
    font-weight: 900;
}

#summaryProgressOk::chunk {
    background-color: #22C55E;
}

#summaryProgressWarning::chunk {
    background-color: #EAB308;
}

#summaryProgressDanger::chunk {
    background-color: #EF4444;
}

/* =========================
   BADGES
   ========================= */
#badge_ok,
#findingBadge_success {
    background-color: rgba(34, 197, 94, 0.14);
    color: #86EFAC;
    border: 1px solid rgba(34, 197, 94, 0.34);
    border-radius: 14px;
    padding: 5px 11px;
    font-weight: 800;
}

#badge_warning,
#findingBadge_warning {
    background-color: rgba(234, 179, 8, 0.14);
    color: #FDE68A;
    border: 1px solid rgba(234, 179, 8, 0.35);
    border-radius: 14px;
    padding: 5px 11px;
    font-weight: 800;
}

#badge_danger,
#findingBadge_critical {
    background-color: rgba(239, 68, 68, 0.14);
    color: #FCA5A5;
    border: 1px solid rgba(239, 68, 68, 0.35);
    border-radius: 14px;
    padding: 5px 11px;
    font-weight: 800;
}

#badge_info,
#findingBadge_info {
    background-color: rgba(59, 130, 246, 0.14);
    color: #93C5FD;
    border: 1px solid rgba(59, 130, 246, 0.35);
    border-radius: 14px;
    padding: 5px 11px;
    font-weight: 800;
}

#badge_neutral {
    background-color: rgba(148, 163, 184, 0.12);
    color: #CBD5E1;
    border: 1px solid rgba(148, 163, 184, 0.25);
    border-radius: 14px;
    padding: 5px 11px;
    font-weight: 800;
}

/* =========================
   METADATA / FINDINGS
   ========================= */
#metadataCountLabel,
#findingsPreviewSubtitle,
#findingsPreviewMuted,
#FindingSubtitle,
#FindingEmptyText,
#findingItemMuted {
    color: #94A3B8;
    font-size: 12px;
}

#metadataHighlightsBox {
    background-color: #0B1220;
    border: 1px solid #1E293B;
    border-radius: 14px;
}

#metadataInsightBox,
#expertNoteBox {
    background-color: rgba(56, 189, 248, 0.08);
    border-left: 4px solid #38BDF8;
    border-radius: 12px;
}

#metadataInsightTitle,
#expertNoteTitle {
    color: #E0F2FE;
    font-size: 14px;
    font-weight: 900;
}

#expertNoteText {
    color: #CBD5E1;
    font-size: 13px;
}

#findingItemInfo,
#findingItemWarning,
#findingItemCritical,
#findingItemSuccess {
    background-color: #111827;
    border-radius: 16px;
    padding: 10px;
}

#findingItemInfo {
    border: 1px solid rgba(59, 130, 246, 0.35);
}

#findingItemWarning {
    border: 1px solid rgba(234, 179, 8, 0.42);
}

#findingItemCritical {
    border: 1px solid rgba(239, 68, 68, 0.48);
}

#findingItemSuccess {
    border: 1px solid rgba(34, 197, 94, 0.38);
}

#findingItemTitle {
    color: #F8FAFC;
    font-size: 15px;
    font-weight: 900;
}

#findingItemText {
    color: #CBD5E1;
    font-size: 13px;
}

/* =========================
   OCR
   ========================= */
#PdfViewer,
#OcrTextViewer {
    background-color: #111827;
    border: 1px solid #243244;
    border-radius: 18px;
    padding: 10px;
}

#PdfPageImage {
    background-color: #F8FAFC;
    border: 1px solid #334155;
    border-radius: 10px;
    margin-bottom: 14px;
}

#OcrTextArea {
    background-color: #0B1220;
    color: #CBD5E1;
    border: 1px solid #1E293B;
    border-radius: 12px;
    padding: 12px;
    font-family: Consolas, "Courier New", monospace;
    font-size: 12px;
    selection-background-color: #2563EB;
    selection-color: #FFFFFF;
}

/* =========================================================
   HASH PAGE 2.1 — ESTRUTURA PRINCIPAL
   ========================================================= */

/*
   Página completa de hashes.
*/
QWidget#HashPage {

    /* Mantém o fundo integrado ao workspace. */
    background: transparent;

    /* Remove qualquer borda herdada. */
    border: none;
}


/*
   Área do título e subtítulo.
*/
QWidget#HashHeader {

    /* Não cria um retângulo adicional. */
    background: transparent;

    /* Remove bordas herdadas. */
    border: none;
}


/* =========================================================
   CARDS CLICÁVEIS
   ========================================================= */

/*
   Estilo base dos quatro cards.
*/
QPushButton#HashSummaryButton {

    /* Altura mínima do card. */
    min-height: 76px;

    /* Remove o padding global de QPushButton. */
    padding: 0;

    /* Alinha o layout interno à esquerda. */
    text-align: left;

    /* Fundo principal do card. */
    background-color: #111827;

    /* Borda padrão discreta. */
    border: 1px solid #243244;

    /* Arredondamento do card. */
    border-radius: 12px;
}


/*
   Card quando o mouse passa.
*/
QPushButton#HashSummaryButton:hover {

    /* Clareia levemente o fundo. */
    background-color: #151F31;

    /* Reforça a borda. */
    border-color: #3A4A63;
}


/*
   Card ativo como filtro.
*/
QPushButton#HashSummaryButton:checked {

    /* Fundo azul discreto. */
    background-color: rgba(37, 99, 235, 0.13);

    /* Borda azul mais visível. */
    border: 2px solid #3B82F6;
}


/*
   Card ativo durante o hover.
*/
QPushButton#HashSummaryButton:checked:hover {

    /* Mantém o estado selecionado. */
    background-color: rgba(37, 99, 235, 0.18);

    /* Mantém a borda azul. */
    border-color: #60A5FA;
}


/*
   Card de todos os arquivos.
*/
QPushButton#HashSummaryButton[cardType="total"] {

    /* Linha lateral azul. */
    border-left: 4px solid #3B82F6;
}


/*
   Card de arquivos únicos.
*/
QPushButton#HashSummaryButton[cardType="unique"] {

    /* Linha lateral verde. */
    border-left: 4px solid #22C55E;
}


/*
   Card de duplicados.
*/
QPushButton#HashSummaryButton[cardType="duplicate"] {

    /* Linha lateral amarela. */
    border-left: 4px solid #F59E0B;
}


/*
   Card de grupos.
*/
QPushButton#HashSummaryButton[cardType="groups"] {

    /* Linha lateral roxa. */
    border-left: 4px solid #8B5CF6;
}


/*
   Ícone presente em cada card.
*/
QLabel#HashSummaryIcon {

    /* Fundo neutro padrão. */
    background-color: rgba(148, 163, 184, 0.10);

    /* Borda discreta. */
    border: 1px solid rgba(148, 163, 184, 0.18);

    /* Formato arredondado. */
    border-radius: 9px;

    /* Cor padrão do ícone. */
    color: #CBD5E1;

    /* Tamanho do ícone textual. */
    font-size: 18px;

    /* Peso visual. */
    font-weight: 800;
}


/*
   Ícone do card total.
*/
QLabel#HashSummaryIcon[cardType="total"] {

    /* Fundo azul translúcido. */
    background-color: rgba(59, 130, 246, 0.14);

    /* Cor azul clara. */
    color: #93C5FD;

    /* Borda azul discreta. */
    border-color: rgba(59, 130, 246, 0.28);
}


/*
   Ícone do card único.
*/
QLabel#HashSummaryIcon[cardType="unique"] {

    /* Fundo verde translúcido. */
    background-color: rgba(34, 197, 94, 0.14);

    /* Cor verde clara. */
    color: #86EFAC;

    /* Borda verde discreta. */
    border-color: rgba(34, 197, 94, 0.28);
}


/*
   Ícone do card duplicado.
*/
QLabel#HashSummaryIcon[cardType="duplicate"] {

    /* Fundo amarelo translúcido. */
    background-color: rgba(245, 158, 11, 0.14);

    /* Cor amarela clara. */
    color: #FCD34D;

    /* Borda amarela discreta. */
    border-color: rgba(245, 158, 11, 0.28);
}


/*
   Ícone do card de grupos.
*/
QLabel#HashSummaryIcon[cardType="groups"] {

    /* Fundo roxo translúcido. */
    background-color: rgba(139, 92, 246, 0.14);

    /* Cor roxa clara. */
    color: #C4B5FD;

    /* Borda roxa discreta. */
    border-color: rgba(139, 92, 246, 0.28);
}


/*
   Número principal dos cards.
*/
QLabel#HashSummaryValue {

    /* Fundo transparente. */
    background: transparent;

    /* Remove borda. */
    border: none;

    /* Cor principal. */
    color: #F8FAFC;

    /* Tamanho grande. */
    font-size: 22px;

    /* Peso forte. */
    font-weight: 800;
}


/*
   Número do total.
*/
QLabel#HashSummaryValue[cardType="total"] {

    /* Azul claro. */
    color: #93C5FD;
}


/*
   Número dos únicos.
*/
QLabel#HashSummaryValue[cardType="unique"] {

    /* Verde claro. */
    color: #86EFAC;
}


/*
   Número dos duplicados.
*/
QLabel#HashSummaryValue[cardType="duplicate"] {

    /* Amarelo claro. */
    color: #FCD34D;
}


/*
   Número dos grupos.
*/
QLabel#HashSummaryValue[cardType="groups"] {

    /* Roxo claro. */
    color: #C4B5FD;
}


/*
   Descrição inferior de cada card.
*/
QLabel#HashSummaryTitle {

    /* Fundo transparente. */
    background: transparent;

    /* Remove borda. */
    border: none;

    /* Cor secundária. */
    color: #94A3B8;

    /* Tamanho compacto. */
    font-size: 11px;

    /* Peso médio. */
    font-weight: 600;
}


/*
   Clareia o título quando o card está ativo.
*/
QPushButton#HashSummaryButton:checked QLabel#HashSummaryTitle {

    /* Cor clara. */
    color: #E5E7EB;
}


/* =========================================================
   BARRA DO ALGORITMO
   ========================================================= */

/*
   Barra abaixo dos cards.
*/
QFrame#HashToolbar {

    /* Fundo integrado ao tema. */
    background-color: #101827;

    /* Borda discreta. */
    border: 1px solid #22314A;

    /* Arredondamento. */
    border-radius: 10px;
}


/*
   Texto explicativo da barra.
*/
QLabel#HashToolbarInformation {

    /* Fundo transparente. */
    background: transparent;

    /* Remove borda. */
    border: none;

    /* Cor secundária. */
    color: #7F8FA8;

    /* Tamanho da fonte. */
    font-size: 11px;
}


/*
   Texto Algoritmo.
*/
QLabel#HashToolbarLabel {

    /* Fundo transparente. */
    background: transparent;

    /* Remove borda. */
    border: none;

    /* Cor clara. */
    color: #A8B5C9;

    /* Tamanho compacto. */
    font-size: 12px;

    /* Peso médio. */
    font-weight: 700;
}


/*
   Seletor de algoritmo.
*/
QComboBox#HashSelector {

    /* Largura mínima. */
    min-width: 130px;

    /* Altura mínima. */
    min-height: 31px;

    /* Espaço interno. */
    padding: 0 10px;

    /* Fundo do campo. */
    background-color: #0B1220;

    /* Cor do texto. */
    color: #E5E7EB;

    /* Borda padrão. */
    border: 1px solid #293850;

    /* Arredondamento. */
    border-radius: 7px;

    /* Tamanho da fonte. */
    font-size: 12px;

    /* Peso médio. */
    font-weight: 600;
}


/*
   Seletor no hover ou foco.
*/
QComboBox#HashSelector:hover,
QComboBox#HashSelector:focus {

    /* Borda azul. */
    border-color: #3B82F6;
}


/*
   Área da seta.
*/
QComboBox#HashSelector::drop-down {

    /* Largura reservada. */
    width: 26px;

    /* Remove borda adicional. */
    border: none;
}


/*
   Lista suspensa de algoritmos.
*/
QComboBox#HashSelector QAbstractItemView {

    /* Fundo da lista. */
    background-color: #111827;

    /* Cor dos itens. */
    color: #E5E7EB;

    /* Borda da lista. */
    border: 1px solid #293850;

    /* Fundo da seleção. */
    selection-background-color: #2563EB;

    /* Cor da seleção. */
    selection-color: #FFFFFF;
}


/* =========================================================
   TÍTULO DA TABELA
   ========================================================= */

/*
   Título que muda conforme o filtro.
*/
QLabel#HashTableTitle {

    /* Fundo transparente. */
    background: transparent;

    /* Remove borda. */
    border: none;

    /* Cor principal. */
    color: #E8EEF8;

    /* Tamanho da fonte. */
    font-size: 14px;

    /* Peso forte. */
    font-weight: 700;

    /* Pequeno espaço lateral. */
    padding-left: 2px;
}


/* =========================================================
   TABELA
   ========================================================= */

/*
   Estrutura da tabela.
*/
QTableWidget#HashTable {

    /* Fundo da tabela. */
    background-color: #0B1220;

    /* Cor padrão do texto. */
    color: #CBD5E1;

    /* Borda externa. */
    border: 1px solid #243244;

    /* Arredondamento. */
    border-radius: 12px;

    /* Remove linhas de grade. */
    gridline-color: transparent;

    /* Fundo da seleção. */
    selection-background-color: rgba(37, 99, 235, 0.22);

    /* Cor da seleção. */
    selection-color: #FFFFFF;

    /* Fonte apropriada para hashes. */
    font-family: Consolas, "Courier New", monospace;

    /* Tamanho da fonte. */
    font-size: 11px;

    /* Remove contorno de foco. */
    outline: none;
}


/*
   Cada célula da tabela.
*/
QTableWidget#HashTable::item {

    /* Espaçamento interno. */
    padding: 8px;

    /* Linha inferior discreta. */
    border-bottom: 1px solid #172235;
}


/*
   Célula no hover.
*/
QTableWidget#HashTable::item:hover {

    /* Destaque discreto. */
    background-color: rgba(59, 130, 246, 0.06);
}


/*
   Célula selecionada.
*/
QTableWidget#HashTable::item:selected {

    /* Fundo azul translúcido. */
    background-color: rgba(37, 99, 235, 0.22);

    /* Texto branco. */
    color: #FFFFFF;
}


/*
   Cabeçalho das colunas.
*/
QTableWidget#HashTable QHeaderView::section {

    /* Fundo do cabeçalho. */
    background-color: #111827;

    /* Cor do texto. */
    color: #DCE6F5;

    /* Remove borda geral. */
    border: none;

    /* Linha inferior. */
    border-bottom: 1px solid #293850;

    /* Divisão visual entre colunas. */
    border-right: 1px solid #1D293B;

    /* Espaçamento interno. */
    padding: 10px 8px;

    /* Peso forte. */
    font-weight: 700;

    /* Tamanho compacto. */
    font-size: 11px;
}


/*
   Cabeçalho durante o hover.

   Esse destaque também ajuda a indicar
   que as colunas podem ser redimensionadas.
*/
QTableWidget#HashTable QHeaderView::section:hover {

    /* Fundo um pouco mais claro. */
    background-color: #172235;

    /* Cor branca. */
    color: #FFFFFF;
}


/* =========================================================
   STATUS
   ========================================================= */

/*
   Contêiner do badge de status.
*/
QWidget#HashStatusContainer {

    /* Fundo transparente. */
    background: transparent;

    /* Remove borda. */
    border: none;
}


/*
   Formato base do badge.
*/
QLabel#HashStatusBadge {

    /* Altura mínima. */
    min-height: 23px;

    /* Espaçamento horizontal. */
    padding: 0 9px;

    /* Arredondamento. */
    border-radius: 7px;

    /* Tamanho da fonte. */
    font-size: 10px;

    /* Peso forte. */
    font-weight: 700;
}


/*
   Arquivo único.
*/
QLabel#HashStatusBadge[statusType="unique"] {

    /* Fundo verde translúcido. */
    background-color: rgba(34, 197, 94, 0.14);

    /* Texto verde. */
    color: #86EFAC;

    /* Borda verde. */
    border: 1px solid rgba(34, 197, 94, 0.30);
}


/*
   Arquivo duplicado ou grupo duplicado.
*/
QLabel#HashStatusBadge[statusType="duplicate"] {

    /* Fundo amarelo translúcido. */
    background-color: rgba(245, 158, 11, 0.14);

    /* Texto amarelo. */
    color: #FCD34D;

    /* Borda amarela. */
    border: 1px solid rgba(245, 158, 11, 0.32);
}


/*
   Hash indisponível.
*/
QLabel#HashStatusBadge[statusType="unavailable"] {

    /* Fundo neutro. */
    background-color: rgba(148, 163, 184, 0.12);

    /* Texto neutro. */
    color: #CBD5E1;

    /* Borda neutra. */
    border: 1px solid rgba(148, 163, 184, 0.24);
}


/* =========================================================
   ESTADO VAZIO
   ========================================================= */

/*
   Mensagem exibida quando não existem
   resultados para o filtro.
*/
QLabel#HashEmptyLabel {

    /* Altura mínima. */
    min-height: 180px;

    /* Cor secundária. */
    color: #94A3B8;

    /* Fundo discreto. */
    background-color: #101827;

    /* Borda tracejada. */
    border: 1px dashed #334155;

    /* Arredondamento. */
    border-radius: 12px;

    /* Tamanho da fonte. */
    font-size: 13px;

    /* Peso médio. */
    font-weight: 600;
}

/* ========================
   TIMELINE PAGE
   ======================== */
#TimelinePage {
    background-color: #07111f;
}

#TimelinePageTitle {
    color: #f8fafc;
    font-size: 20px;
    font-weight: 700;
}

#TimelinePageSubtitle {
    color: #cbd5e1;
    font-size: 13px;
}

#TechnicalTimeline {
    background-color: transparent;
}

#TimelineFilterButton {
    background-color: #101827;
    color: #cbd5e1;
    border: 1px solid #25324a;
    border-radius: 8px;
    padding: 8px 14px;
    font-size: 13px;
}

#TimelineFilterButton:checked {
    background-color: #2563eb;
    color: #ffffff;
    border: 1px solid #3b82f6;
}

#TimelineScroll {
    background-color: #0b1320;
    border: 1px solid #1e293b;
    border-radius: 10px;
}

#TimelineScroll > QWidget > QWidget {
    background-color: transparent;
}

#TimelineListContainer {
    background-color: transparent;
}

#TimelineEventRow {
    background-color: rgba(15, 23, 42, 0.84);
    border-bottom: 1px solid #1e293b;
    min-height: 50px;
}

#TimelineTimeBox {
    min-width: 105px;
    max-width: 105px;
    background-color: transparent;
}

#TimelineDateLabel {
    color: #cbd5e1;
    font-size: 13px;
}

#TimelineHourLabel {
    color: #38bdf8;
    font-size: 13px;
    font-weight: 700;
}

#TimelineMarker {
    background-color: transparent;
}

#TimelineVerticalLine {
    background-color: #334155;
}

#TimelineDot {
    border-radius: 14px;
    color: white;
    font-size: 13px;
    font-weight: 700;
    background-color: #64748b;
}

#TimelineDot[eventType="creation"] {
    background-color: #22c55e;
}

#TimelineDot[eventType="modification"] {
    background-color: #f59e0b;
}

#TimelineDot[eventType="signature"] {
    background-color: #2563eb;
}

#TimelineDot[eventType="access"] {
    background-color: #8b5cf6;
}

#TimelineDot[eventType="system"] {
    background-color: #94a3b8;
}

#TimelineContentBox {
    background-color: transparent;
}

#TimelineEventTitle {
    color: #f8fafc;
    font-size: 13px;
    font-weight: 700;
}

#TimelineEventDescription {
    color: #cbd5e1;
    font-size: 12px;
}

#TimelineEventDetails {
    color: #94a3b8;
    font-size: 13px;
}

#TimelineRightBox {
    min-width: 150px;
    max-width: 190px;
    background-color: transparent;
}

#TimelineBadge {
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 12px;
    font-weight: 700;
    color: #e2e8f0;
    border: 1px solid #475569;
}

#TimelineBadge[eventType="creation"] {
    color: #86efac;
    border-color: #22c55e;
}

#TimelineBadge[eventType="modification"] {
    color: #fde68a;
    border-color: #f59e0b;
}

#TimelineBadge[eventType="signature"] {
    color: #93c5fd;
    border-color: #2563eb;
}

#TimelineBadge[eventType="access"] {
    color: #c4b5fd;
    border-color: #8b5cf6;
}

#TimelineBadge[eventType="system"] {
    color: #cbd5e1;
    border-color: #64748b;
}

#TimelineSource {
    color: #94a3b8;
    font-size: 12px;
}

#TimelineFooter {
    color: #cbd5e1;
    font-size: 12px;
    padding-left: 8px;
}

#TimelineEmpty {
    color: #94a3b8;
    padding: 60px;
    font-size: 14px;
}

#TimelineSidePanel {
    background-color: transparent;
    min-width: 310px;
    max-width: 390px;
}

#TimelineInfoCard {
    background-color: #0b1320;
    border: 1px solid #1e293b;
    border-radius: 10px;
}

#TimelineInfoTitle {
    color: #f8fafc;
    font-size: 14px;
    font-weight: 700;
}

#TimelineInfoContent {
    color: #cbd5e1;
    font-size: 13px;
    line-height: 1.5em;
}

/* ========================
   TIMELINE CARDS
   ======================== */

#TimelineEventCard {
    background-color: #101827;
    border: 1px solid #1e293b;
    border-radius: 10px;
    margin-top: 3px;
    margin-bottom: 3px;
}

#TimelineEventCard[eventType="creation"] {
    border-left: 4px solid #22c55e;
}

#TimelineEventCard[eventType="modification"] {
    border-left: 4px solid #f59e0b;
}

#TimelineEventCard[eventType="signature"] {
    border-left: 4px solid #2563eb;
}

#TimelineEventCard[eventType="access"] {
    border-left: 4px solid #8b5cf6;
}

#TimelineEventCard[eventType="system"] {
    border-left: 4px solid #94a3b8;
}

#TimelineEventIcon {
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
    border-radius: 14px;
    background-color: #172033;
    color: #e2e8f0;
    font-size: 13px;
}

#TimelineHourBadge {
    background-color: #101827;
    color: #38bdf8;
    border: 1px solid #1e40af;
    border-radius: 8px;
    padding: 5px 8px;
    font-size: 12px;
    font-weight: 700;
}

#TimelineMiniStat {
    background-color: #101827;
    border: 1px solid #1e293b;
    border-radius: 10px;
}

#TimelineMiniStatValue {
