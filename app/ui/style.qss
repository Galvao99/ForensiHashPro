/* =========================================================
   FORENSIHASH PRO - CLEAN DARK THEME
   Tipografia consolidada e duplicidades removidas
   ========================================================= */

/* =========================
   GLOBAL
   ========================= */
QWidget {
    background-color: #0B1120;
    color: #E5E7EB;
    font-family: "Segoe UI", "Inter", "Arial";
    font-size: 13px;
}

QLabel {
    background: transparent;
}

#Content,
QWidget#TimelinePage {
    background-color: #0B1120;
}

#PageTitle {
    font-size: 28px;
    font-weight: 900;
    color: #F8FAFC;
}

#SectionTitle {
    font-size: 22px;
    font-weight: 900;
    color: #F8FAFC;
}

#SectionSubtitle {
    font-size: 13px;
    color: #94A3B8;
}

#ClockLabel {
    color: #60A5FA;
    font-size: 12px;
    font-weight: 600;
}

/* =========================================================
   NOVA SIDEBAR
   ========================================================= */

QFrame#Sidebar {
    min-width: 250px;
    max-width: 310px;
    background-color: #070d1d;
    border-right: 1px solid #1d2a42;
}

QLabel#SidebarTitle {
    color: #F8FAFC;
    font-size: 24px;
    font-weight: 800;
}

QLabel#SidebarSubtitle {
    color: #38BDF8;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 2px;
}

QListWidget#SidebarFileList {
    font-size: 12px;
}

QListWidget#SidebarFileList::item {
    min-height: 32px;
    padding: 4px 8px;
}

QFrame#SidebarSeparator {
    max-height: 1px;
    background-color: #1d2a42;
    border: none;
    margin-top: 4px;
    margin-bottom: 4px;
}

QLabel#SidebarSectionTitle {
    color: #687b9c;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    padding: 2px 4px;
}

QPushButton#SidebarActionButton {
    min-height: 42px;
    padding: 0 12px;
    text-align: left;
    border: 1px solid #202e49;
    border-radius: 9px;
    background-color: #111a2d;
    color: #d7e2f5;
    font-size: 13px;
    font-weight: 700;
}

QPushButton#SidebarActionButton:hover {
    background-color: #17233a;
    border-color: #31507c;
}

QScrollArea#SidebarNavigationScroll {
    background: transparent;
    border: none;
}

QWidget#SidebarNavigationContainer {
    background: transparent;
}

QPushButton#SidebarNavigationButton {
    min-height: 42px;
    border: none;
    border-radius: 8px;
    background-color: transparent;
    text-align: left;
}

QPushButton#SidebarNavigationButton:hover {
    background-color: rgba(59, 130, 246, 0.09);
}

QPushButton#SidebarNavigationButton:checked {
    background-color: rgba(59, 130, 246, 0.17);
    border-left: 3px solid #3b82f6;
}

QLabel#SidebarNavigationIcon {
    color: #7691bd;
    font-size: 15px;
    font-weight: 700;
}

QLabel#SidebarNavigationText {
    color: #c4d0e4;
    font-size: 13px;
    font-weight: 700;
}

QPushButton#SidebarNavigationButton:checked QLabel#SidebarNavigationIcon,
QPushButton#SidebarNavigationButton:checked QLabel#SidebarNavigationText {
    color: #ffffff;
}


/* =========================================================
   WORKSPACE
   ========================================================= */

QStackedWidget#AnalysisWorkspace {
    background: transparent;
}

QLabel#WorkspaceContextLabel {
    color: #71819c;
    font-size: 12px;
}

QFrame#AnalysisProgressContainer {
    background-color: rgba(17, 26, 45, 0.75);
    border: 1px solid #1d2a42;
    border-radius: 9px;
}

QLabel#AnalysisStatusLabel {
    color: #8495b3;
    font-size: 11px;
}

QProgressBar{

    min-height:10px;
    max-height:10px;
    border:none;
    border-radius:5px;
    background:#1E2A40;

}

QProgressBar::chunk{

    border-radius:5px;
    background:#3B82F6;

}


/* =========================================================
   HOME
   ========================================================= */

QFrame#HomeHeroCard {
    background-color: #111a2d;
    border: 1px solid #23324e;
    border-radius: 16px;
}

QLabel#HomeHeroBadge {
    color: #46b9ff;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 2px;
}

QLabel#HomeHeroTitle {
    color: #f3f7ff;
    font-size: 31px;
    font-weight: 800;
}

QLabel#HomeHeroSubtitle {
    color: #91a0b8;
    font-size: 13px;
}

QPushButton#HomePrimaryButton,
QPushButton#HomeSecondaryButton {
    min-height: 42px;
    padding: 0 18px;
    border-radius: 9px;
    font-size: 13px;
    font-weight: 700;
}

QPushButton#HomePrimaryButton {
    background-color: #2563eb;
    border: 1px solid #3b82f6;
    color: white;
}

QPushButton#HomePrimaryButton:hover {
    background-color: #3274f4;
}

QPushButton#HomeSecondaryButton {
    background-color: #151f34;
    border: 1px solid #2a3a59;
    color: #d8e3f6;
}

QPushButton#HomeSecondaryButton:hover {
    background-color: #1b2942;
}

QFrame#HomeInfoCard {
    background-color: #101829;
    border: 1px solid #202d46;
    border-radius: 14px;
}

QLabel#HomeCardTitle {
    color: #edf3ff;
    font-size: 16px;
    font-weight: 700;
}

QLabel#HomeInstructionNumber {
    border-radius: 8px;
    background-color: rgba(59, 130, 246, 0.16);
    color: #7fb5ff;
    font-size: 13px;
    font-weight: 700;
}

QLabel#HomeInstructionTitle {
    color: #dce6f7;
    font-size: 13px;
    font-weight: 700;
}

QLabel#HomeInstructionDescription,
QLabel#HomeWorkspaceDetails {
    color: #7889a6;
    font-size: 12px;
}

QLabel#HomeWorkspaceStatus {
    color: #dce6f7;
    font-size: 14px;
    font-weight: 700;
}

/* =========================
   BUTTONS
   ========================= */
QPushButton {
    background-color: #0F172A;
    color: #CBD5E1;
    border: 1px solid #1E293B;
    border-radius: 12px;
    padding: 11px 14px;
    text-align: left;
    font-weight: 700;
}

QPushButton:hover {
    background-color: #172554;
    color: #FFFFFF;
    border-color: #2563EB;
}

QPushButton:pressed {
    background-color: #1D4ED8;
    border-color: #60A5FA;
}

/* =========================
   TABS
   ========================= */
QTabWidget::pane {
    border: 1px solid #1E293B;
    border-radius: 18px;
    background-color: #0F172A;
    top: -1px;
}

QTabBar::tab {
    background-color: #0F172A;
    color: #94A3B8;
    border: 1px solid #1E293B;
    padding: 11px 18px;
    margin-right: 5px;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    font-weight: 700;
}

QTabBar::tab:selected {
    background-color: #2563EB;
    color: #FFFFFF;
    border-color: #60A5FA;
}

QTabBar::tab:hover:selected {
    background-color: #172554;
    color: #E0F2FE;
}

/* QTabBar::tab:hover:!selected {
    background-color: #172554;
    color: #E0F2FE;
} */

/* =========================
   BASE CARDS
   ========================= */
#BaseCard,
#InfoCard,
#summaryCard,
#metadataCard,
#findingsPreviewCard {
    background-color: #111827;
    border: 1px solid #243244;
    border-radius: 18px;
    padding: 16px;
}

#BaseCard:hover,
#InfoCard:hover,
#summaryCard:hover,
#metadataCard:hover,
#findingsPreviewCard:hover {
    border-color: #334155;
}

#CardTitle,
#DashboardTitle,
#summaryTitle,
#metadataCardTitle,
#findingsPreviewTitle {
    color: #F8FAFC;
    font-weight: 900;
}

#CardContent,
#summaryText,
#metadataHighlightText,
#metadataInsightText,
#findingsPreviewText {
    color: #CBD5E1;
}

/* =========================
   LISTS / TABLES
   ========================= */
QListWidget,
QTableWidget {
    background-color: #0F172A;
    color: #E5E7EB;
    border: 1px solid #1E293B;
    border-radius: 14px;
    padding: 8px;
    gridline-color: #1E293B;
    selection-background-color: #2563EB;
    selection-color: #FFFFFF;
}

QListWidget::item {
    padding: 8px;
    border-radius: 8px;
}

QListWidget::item:hover {
    background-color: #1E293B;
}

QListWidget::item:selected {
    background-color: #2563EB;
    color: #FFFFFF;
}

QTableWidget::item {
    padding: 8px;
}

QTableWidget::item:hover {
    background-color: #1E293B;
}

QHeaderView::section {
    background-color: #111827;
    color: #F8FAFC;
    border: none;
    padding: 9px;
    font-weight: 800;
}

/* =========================
   INPUTS
   ========================= */
QLineEdit,
QDateTimeEdit,
QComboBox,
#HashSelector {
    background-color: #0B1220;
    color: #E5E7EB;
    border: 1px solid #1E293B;
    border-radius: 10px;
    padding: 8px 12px;
}

QLineEdit:focus,
QDateTimeEdit:focus,
QComboBox:hover,
#HashSelector:hover {
    border-color: #38BDF8;
}

QLineEdit::placeholder {
    color: #64748B;
}

/* =========================
   SCROLL
   ========================= */
QScrollArea,
#MainScrollArea,
#FindingScrollArea,
#TimelineScroll {
    border: none;
    background: transparent;
}

QScrollBar:vertical {
    background: #0F172A;
    width: 12px;
    margin: 4px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background: #334155;
    min-height: 40px;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background: #475569;
}

QScrollBar:horizontal {
    background: #0F172A;
    height: 12px;
    margin: 4px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background: #334155;
    min-width: 40px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal:hover {
    background: #475569;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0px;
    height: 0px;
}

/* =========================
   SMART TIMELINE
   ========================= */
QWidget#SmartTimeline {
    background-color: #0F172A;
    border: 1px solid #243244;
    border-radius: 16px;
    min-height: 155px;
}

QFrame#SmartTimelineTrack {
    background-color: #334155;
    border: none;
    margin-left: 45px;
    margin-right: 45px;
}

QWidget#TimelineNode {
    background: transparent;
}

QLabel#TimelineNodeDot {
    font-size: 18px;
    font-weight: 900;
}

QFrame#TimelineNodeLine {
    background-color: #475569;
    border: none;
    min-width: 2px;
    max-width: 2px;
}

QLabel#TimelineNodeTitle {
    color: #F8FAFC;
    font-size: 12px;
    font-weight: 800;
}

QLabel#TimelineNodeDate {
    color: #BFDBFE;
    font-size: 11px;
    font-weight: 600;
}

/* =========================
   TECHNICAL TIMELINE CARDS
   ========================= */
QWidget#TechnicalTimeline {
    background: transparent;
}

QFrame#TimelineEventCard {
    background-color: #111827;
    border: 1px solid #243244;
    border-radius: 16px;
    min-height: 190px;
}

QFrame#TimelineEventCard:hover {
    background-color: #162033;
    border-color: #3B82F6;
}

QLabel#TimelineCardDot {
    font-size: 22px;
    font-weight: 900;
}

QLabel#TimelineCardTitle {
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 800;
}

QLabel#TimelineCardDate {
    color: #BFDBFE;
    font-size: 12px;
    font-weight: 600;
}

QLabel#TimelineCardSource {
    color: #DBEAFE;
    background-color: #0B1222;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 5px 8px;
    font-size: 11px;
}

QLabel#TimelineCardDescription {
    color: #CBD5E1;
    font-size: 12px;
}

QLabel#TimelineResult {
    color: #FBBF24;
    background-color: rgba(251, 146, 60, 0.10);
    border: 1px solid rgba(251, 146, 60, 0.35);
    border-radius: 12px;
    padding: 12px;
    font-size: 12px;
}

/* =========================
   CONTRACT DATE CONFIRMATION
   ========================= */
QFrame#ContractDateConfirmationCard {
    background-color: #111C33;
    border: 1px solid #F59E0B;
    border-radius: 14px;
}

QLabel#ContractDateTitle {
    color: #FBBF24;
    font-size: 15px;
    font-weight: 800;
}

QLabel#ContractDateMessage {
    color: #CBD5E1;
    font-size: 13px;
}

/* =========================
   SUMMARY / PROGRESS
   ========================= */
QProgressBar {
    background-color: #1E293B;
    border: none;
    border-radius: 6px;
    color: #F8FAFC;
    text-align: center;
    height: 22px;
    font-weight: 800;
}

QProgressBar::chunk {
    background-color: #2563EB;
    border-radius: 6px;
}

#summaryScoreOk {
    color: #86EFAC;
    font-weight: 900;
}

#summaryScoreWarning {
    color: #FDE68A;
    font-weight: 900;
}

#summaryScoreDanger {
    color: #FDA4AF;
    font-weight: 900;
}

#summaryProgressOk::chunk {
    background-color: #22C55E;
}

#summaryProgressWarning::chunk {
    background-color: #EAB308;
}

#summaryProgressDanger::chunk {
    background-color: #EF4444;
}

/* =========================
   BADGES
   ========================= */
#badge_ok,
#findingBadge_success {
    background-color: rgba(34, 197, 94, 0.14);
    color: #86EFAC;
    border: 1px solid rgba(34, 197, 94, 0.34);
    border-radius: 14px;
    padding: 5px 11px;
    font-weight: 800;
}

#badge_warning,
#findingBadge_warning {
    background-color: rgba(234, 179, 8, 0.14);
    color: #FDE68A;
    border: 1px solid rgba(234, 179, 8, 0.35);
    border-radius: 14px;
    padding: 5px 11px;
    font-weight: 800;
}

#badge_danger,
#findingBadge_critical {
    background-color: rgba(239, 68, 68, 0.14);
    color: #FCA5A5;
    border: 1px solid rgba(239, 68, 68, 0.35);
    border-radius: 14px;
    padding: 5px 11px;
    font-weight: 800;
}

#badge_info,
#findingBadge_info {
    background-color: rgba(59, 130, 246, 0.14);
    color: #93C5FD;
    border: 1px solid rgba(59, 130, 246, 0.35);
    border-radius: 14px;
    padding: 5px 11px;
    font-weight: 800;
}

#badge_neutral {
    background-color: rgba(148, 163, 184, 0.12);
    color: #CBD5E1;
    border: 1px solid rgba(148, 163, 184, 0.25);
    border-radius: 14px;
    padding: 5px 11px;
    font-weight: 800;
}

/* =========================
   METADATA / FINDINGS
   ========================= */
#metadataCountLabel,
#findingsPreviewSubtitle,
#findingsPreviewMuted,
#FindingSubtitle,
#FindingEmptyText,
#findingItemMuted {
    color: #94A3B8;
    font-size: 12px;
}

#metadataHighlightsBox {
    background-color: #0B1220;
    border: 1px solid #1E293B;
    border-radius: 14px;
}

#metadataInsightBox,
#expertNoteBox {
    background-color: rgba(56, 189, 248, 0.08);
    border-left: 4px solid #38BDF8;
    border-radius: 12px;
}

#metadataInsightTitle,
#expertNoteTitle {
    color: #E0F2FE;
    font-size: 14px;
    font-weight: 900;
}

#expertNoteText {
    color: #CBD5E1;
    font-size: 13px;
}

#findingItemInfo,
#findingItemWarning,
#findingItemCritical,
#findingItemSuccess {
    background-color: #111827;
    border-radius: 16px;
    padding: 10px;
}

#findingItemInfo {
    border: 1px solid rgba(59, 130, 246, 0.35);
}

#findingItemWarning {
    border: 1px solid rgba(234, 179, 8, 0.42);
}

#findingItemCritical {
    border: 1px solid rgba(239, 68, 68, 0.48);
}

#findingItemSuccess {
    border: 1px solid rgba(34, 197, 94, 0.38);
}

#findingItemTitle {
    color: #F8FAFC;
    font-size: 15px;
    font-weight: 900;
}

#findingItemText {
    color: #CBD5E1;
    font-size: 13px;
}

/* =========================
   OCR
   ========================= */
#PdfViewer,
#OcrTextViewer {
    background-color: #111827;
    border: 1px solid #243244;
    border-radius: 18px;
    padding: 10px;
}

#PdfPageImage {
    background-color: #F8FAFC;
    border: 1px solid #334155;
    border-radius: 10px;
    margin-bottom: 14px;
}

#OcrTextArea {
    background-color: #0B1220;
    color: #CBD5E1;
    border: 1px solid #1E293B;
    border-radius: 12px;
    padding: 12px;
    font-family: Consolas, "Courier New", monospace;
    font-size: 12px;
    selection-background-color: #2563EB;
    selection-color: #FFFFFF;
}

/* =========================
   HASH PAGE
   ========================= */
#HashTable {
    background-color: #0B1220;
    color: #CBD5E1;
    border: 1px solid #243244;
    border-radius: 14px;
    gridline-color: #1E293B;
    selection-background-color: #2563EB;
    selection-color: #FFFFFF;
    font-family: Consolas, "Courier New", monospace;
    font-size: 12px;
}

#HashTable::item {
    padding: 8px;
}

/* ========================
   TIMELINE PAGE
   ======================== */
#TimelinePage {
    background-color: #07111f;
}

#TimelinePageTitle {
    color: #f8fafc;
    font-size: 20px;
    font-weight: 700;
}

#TimelinePageSubtitle {
    color: #cbd5e1;
    font-size: 13px;
}

#TechnicalTimeline {
    background-color: transparent;
}

#TimelineFilterButton {
    background-color: #101827;
    color: #cbd5e1;
    border: 1px solid #25324a;
    border-radius: 8px;
    padding: 8px 14px;
    font-size: 13px;
}

#TimelineFilterButton:checked {
    background-color: #2563eb;
    color: #ffffff;
    border: 1px solid #3b82f6;
}

#TimelineScroll {
    background-color: #0b1320;
    border: 1px solid #1e293b;
    border-radius: 10px;
}

#TimelineScroll > QWidget > QWidget {
    background-color: transparent;
}

#TimelineListContainer {
    background-color: transparent;
}

#TimelineEventRow {
    background-color: rgba(15, 23, 42, 0.84);
    border-bottom: 1px solid #1e293b;
    min-height: 50px;
}

#TimelineTimeBox {
    min-width: 105px;
    max-width: 105px;
    background-color: transparent;
}

#TimelineDateLabel {
    color: #cbd5e1;
    font-size: 13px;
}

#TimelineHourLabel {
    color: #38bdf8;
    font-size: 13px;
    font-weight: 700;
}

#TimelineMarker {
    background-color: transparent;
}

#TimelineVerticalLine {
    background-color: #334155;
}

#TimelineDot {
    border-radius: 14px;
    color: white;
    font-size: 13px;
    font-weight: 700;
    background-color: #64748b;
}

#TimelineDot[eventType="creation"] {
    background-color: #22c55e;
}

#TimelineDot[eventType="modification"] {
    background-color: #f59e0b;
}

#TimelineDot[eventType="signature"] {
    background-color: #2563eb;
}

#TimelineDot[eventType="access"] {
    background-color: #8b5cf6;
}

#TimelineDot[eventType="system"] {
    background-color: #94a3b8;
}

#TimelineContentBox {
    background-color: transparent;
}

#TimelineEventTitle {
    color: #f8fafc;
    font-size: 13px;
    font-weight: 700;
}

#TimelineEventDescription {
    color: #cbd5e1;
    font-size: 12px;
}

#TimelineEventDetails {
    color: #94a3b8;
    font-size: 13px;
}

#TimelineRightBox {
    min-width: 150px;
    max-width: 190px;
    background-color: transparent;
}

#TimelineBadge {
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 12px;
    font-weight: 700;
    color: #e2e8f0;
    border: 1px solid #475569;
}

#TimelineBadge[eventType="creation"] {
    color: #86efac;
    border-color: #22c55e;
}

#TimelineBadge[eventType="modification"] {
    color: #fde68a;
    border-color: #f59e0b;
}

#TimelineBadge[eventType="signature"] {
    color: #93c5fd;
    border-color: #2563eb;
}

#TimelineBadge[eventType="access"] {
    color: #c4b5fd;
    border-color: #8b5cf6;
}

#TimelineBadge[eventType="system"] {
    color: #cbd5e1;
    border-color: #64748b;
}

#TimelineSource {
    color: #94a3b8;
    font-size: 12px;
}

#TimelineFooter {
    color: #cbd5e1;
    font-size: 12px;
    padding-left: 8px;
}

#TimelineEmpty {
    color: #94a3b8;
    padding: 60px;
    font-size: 14px;
}

#TimelineSidePanel {
    background-color: transparent;
    min-width: 310px;
    max-width: 390px;
}

#TimelineInfoCard {
    background-color: #0b1320;
    border: 1px solid #1e293b;
    border-radius: 10px;
}

#TimelineInfoTitle {
    color: #f8fafc;
    font-size: 14px;
    font-weight: 700;
}

#TimelineInfoContent {
    color: #cbd5e1;
    font-size: 13px;
    line-height: 1.5em;
}

/* ========================
   TIMELINE CARDS
   ======================== */

#TimelineEventCard {
    background-color: #101827;
    border: 1px solid #1e293b;
    border-radius: 10px;
    margin-top: 3px;
    margin-bottom: 3px;
}

#TimelineEventCard[eventType="creation"] {
    border-left: 4px solid #22c55e;
}

#TimelineEventCard[eventType="modification"] {
    border-left: 4px solid #f59e0b;
}

#TimelineEventCard[eventType="signature"] {
    border-left: 4px solid #2563eb;
}

#TimelineEventCard[eventType="access"] {
    border-left: 4px solid #8b5cf6;
}

#TimelineEventCard[eventType="system"] {
    border-left: 4px solid #94a3b8;
}

#TimelineEventIcon {
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
    border-radius: 14px;
    background-color: #172033;
    color: #e2e8f0;
    font-size: 13px;
}

#TimelineHourBadge {
    background-color: #101827;
    color: #38bdf8;
    border: 1px solid #1e40af;
    border-radius: 8px;
    padding: 5px 8px;
    font-size: 12px;
    font-weight: 700;
}

#TimelineMiniStat {
    background-color: #101827;
    border: 1px solid #1e293b;
    border-radius: 10px;
}

#TimelineMiniStatValue {
    color: #f8fafc;
    font-size: 20px;
    font-weight: 800;
}

#TimelineMiniStatLabel {
    color: #94a3b8;
    font-size: 11px;
}

/* =======================
   BINARY ANALYSIS 
   ======================= */

#BinaryCard {
    background-color: #101826;
    border: 1px solid #22314a;
    border-radius: 14px;
}

#CardTitle {
    color: #F8FAFC;
    font-size: 15px;
    font-weight: 700;
}

#CardContent {
    color: #CBD5E1;
    font-size: 13px;
}

#BigGreenText {
    color: #4ADE80;
    font-size: 24px;
    font-weight: 800;
}

#StatusBadge,
#ConfidenceBadge {
    padding: 5px 10px;
    border-radius: 8px;
    font-weight: 700;
}

#StatusBadge[kind="success"],
#ConfidenceBadge[kind="success"] {
    color: #86EFAC;
    background-color: rgba(34, 197, 94, 0.16);
    border: 1px solid rgba(34, 197, 94, 0.35);
}

#StatusBadge[kind="warning"],
#ConfidenceBadge[kind="warning"] {
    color: #FACC15;
    background-color: rgba(250, 204, 21, 0.14);
    border: 1px solid rgba(250, 204, 21, 0.35);
}

#StatusBadge[kind="danger"],
#ConfidenceBadge[kind="danger"] {
    color: #FCA5A5;
    background-color: rgba(239, 68, 68, 0.14);
    border: 1px solid rgba(239, 68, 68, 0.35);
}

#BinaryTable {
    background-color: #0B1220;
    color: #E5E7EB;
    border: 1px solid #22314A;
    gridline-color: #22314A;
    border-radius: 8px;
}

#BinaryTable::item {
    padding: 8px;
}

#HexPreview,
#HexViewer {
    background-color: #08111F;
    color: #93C5FD;
    border: 1px solid #1E3A5F;
    border-radius: 10px;
    font-family: Consolas, "Courier New", monospace;
    font-size: 12px;
    padding: 10px;
}

#ConclusionBox {
    background-color: rgba(124, 58, 237, 0.10);
    color: #C4B5FD;
    border: 1px solid rgba(124, 58, 237, 0.45);
    border-radius: 10px;
    padding: 10px;
    font-weight: 600;
}

#SearchToolbar {
    background-color: #101826;
    border: 1px solid #22314A;
    border-radius: 12px;
}

#PrimaryButton {
    background-color: #2563EB;
    color: white;
    border-radius: 8px;
    padding: 8px 14px;
    font-weight: 700;
}

#PrimaryButton:hover {
    background-color: #1D4ED8;
}

/* =========================================================
   VESTÍGIOS 2.0
   ========================================================= */

QFrame#FindingPageHeader {
    background-color: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
}

QLabel#FindingPageTitle {
    font-size: 24px;
    font-weight: 700;
}

QLabel#FindingPageSubtitle {
    font-size: 13px;
    color: #9da4ae;
}

QLabel#FindingSummaryBadge {
    padding: 6px 11px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 600;
}

QLabel#FindingSummaryBadge[summaryType="neutral"] {
    background-color: rgba(148, 163, 184, 0.14);
    color: #cbd5e1;
}

QLabel#FindingSummaryBadge[summaryType="success"] {
    background-color: rgba(34, 197, 94, 0.14);
    color: #86efac;
}

QLabel#FindingSummaryBadge[summaryType="info"] {
    background-color: rgba(59, 130, 246, 0.14);
    color: #93c5fd;
}

QLabel#FindingSummaryBadge[summaryType="warning"] {
    background-color: rgba(245, 158, 11, 0.14);
    color: #fcd34d;
}

QLabel#FindingSummaryBadge[summaryType="critical"] {
    background-color: rgba(239, 68, 68, 0.14);
    color: #fca5a5;
}


/* Filtros */

QPushButton#FindingFilterButton {
    min-height: 36px;
    padding: 4px 14px;
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 8px;
    background-color: rgba(255, 255, 255, 0.035);
    font-size: 12px;
}

QPushButton#FindingFilterButton:hover {
    background-color: rgba(255, 255, 255, 0.07);
}

QPushButton#FindingFilterButton:checked {
    background-color: rgba(59, 130, 246, 0.18);
    border: 1px solid rgba(96, 165, 250, 0.50);
    color: #bfdbfe;
}


/* Cards */

QFrame#InvestigationFindingCard {
    background-color: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 14px;
    padding: 4px;
}

QFrame#InvestigationFindingCard[severity="ok"] {
    border-left: 4px solid #22c55e;
}

QFrame#InvestigationFindingCard[severity="info"] {
    border-left: 4px solid #3b82f6;
}

QFrame#InvestigationFindingCard[severity="warning"] {
    border-left: 4px solid #f59e0b;
}

QFrame#InvestigationFindingCard[severity="critical"] {
    border-left: 4px solid #ef4444;
}

QLabel#FindingTitle {
    font-size: 10px;
    font-weight: 800;
}

QLabel#FindingDescription {
    font-size: 14px;
    color: #D8E1F0;
}

QLabel#FindingSeverityIcon {
    border-radius: 8px;
    font-size: 22px;
    font-weight: 700;
}

QLabel#FindingSeverityIcon[severity="ok"] {
    background-color: rgba(34, 197, 94, 0.14);
    color: #86efac;
}

QLabel#FindingSeverityIcon[severity="info"] {
    background-color: rgba(59, 130, 246, 0.14);
    color: #93c5fd;
}

QLabel#FindingSeverityIcon[severity="warning"] {
    background-color: rgba(245, 158, 11, 0.14);
    color: #fcd34d;
}

QLabel#FindingSeverityIcon[severity="critical"] {
    background-color: rgba(239, 68, 68, 0.14);
    color: #fca5a5;
}

QLabel#FindingSeverityLabel {
    font-size: 14px;
    font-weight: 700;
}

QLabel#FindingSeverityLabel[severity="ok"] {
    color: #86efac;
}

QLabel#FindingSeverityLabel[severity="info"] {
    color: #93c5fd;
}

QLabel#FindingSeverityLabel[severity="warning"] {
    color: #fcd34d;
}

QLabel#FindingSeverityLabel[severity="critical"] {
    color: #fca5a5;
}


/* Badges */

QLabel#EvidenceBadge {
    padding: 5px 12px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 700;
}

QLabel#EvidenceBadge[badgeType="success"] {
    background-color: rgba(34, 197, 94, 0.14);
    color: #86efac;
}

QLabel#EvidenceBadge[badgeType="info"] {
    background-color: rgba(59, 130, 246, 0.14);
    color: #93c5fd;
}

QLabel#EvidenceBadge[badgeType="warning"] {
    background-color: rgba(245, 158, 11, 0.14);
    color: #fcd34d;
}

QLabel#EvidenceBadge[badgeType="critical"] {
    background-color: rgba(239, 68, 68, 0.14);
    color: #fca5a5;
}

QLabel#EvidenceBadge[badgeType="neutral"] {
    background-color: rgba(148, 163, 184, 0.13);
    color: #cbd5e1;
}


/* Relação entre arquivos */

QFrame#FindingRelationBox {
    background-color: rgba(255, 255, 255, 0.025);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 9px;
    padding: 10px;
}

QLabel#FindingRelationArrow {
    color: #64748b;
    font-size: 15px;
    font-weight: 700;
}

QLabel#FindingSourceFile,
QLabel#FindingTargetFile {
    font-size: 14px;
    color: #aab1bc;
}


/* Detalhes */

QPushButton#FindingDetailsButton {
    border: none;
    background: transparent;
    color: #93c5fd;
    font-size: 14px;
    text-align: left;
    padding: 3px 0;
}

QPushButton#FindingDetailsButton:hover {
    color: #bfdbfe;
}

QLabel#FindingMetadata {
    padding: 12px;
    border-radius: 8px;
    background-color: rgba(0, 0, 0, 0.18);
    font-family: Consolas, "Courier New", monospace;
    font-size: 13px;
    color: #b8bec7;
}


/* Estado vazio */

QFrame#FindingEmptyState {
    background-color: rgba(255, 255, 255, 0.025);
    border: 1px dashed rgba(255, 255, 255, 0.10);
    border-radius: 14px;
}

QLabel#FindingEmptyIcon {
    font-size: 32px;
    color: #64748b;
}

QLabel#FindingEmptyTitle {
    font-size: 14px;
    font-weight: 700;
}

QLabel#FindingEmptyDescription {
    color: #8f96a1;
    font-size: 11px;
}

/* =========================================================
   PAINEL INVESTIGATIVO
   ========================================================= */

QScrollArea#FindingLeftScroll {
    background: transparent;
    border: none;
}

QWidget#FindingLeftContent {
    background: transparent;
}

QFrame#InvestigationSection {
    background-color: rgba(255, 255, 255, 0.025);
    border: 1px solid rgba(255, 255, 255, 0.075);
    border-radius: 13px;
}

QLabel#InvestigationSectionTitle {
    font-size: 20px;
    font-weight: 800;
}

QLabel#InvestigationSectionCount {
    border-radius: 7px;
    background-color: rgba(148, 163, 184, 0.13);
    color: #cbd5e1;
    font-size: 13px;
    font-weight: 700;
}


/* =========================================================
   PAINEL DO ARQUIVO
   ========================================================= */

QFrame#FileInvestigationPanel {
    background-color: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 14px;
}

QLabel#InspectorTitle {
    font-size: 20px;
    font-weight: 700;
}

QLabel#InspectorFileName {
    font-size: 15px;
    font-weight: 700;
    color: #93c5fd;
}

QLabel#InspectorSectionTitle {
    font-size: 14px;
    font-weight: 700;
}

QLabel#InspectorFieldTitle {
    color: #87909c;
    font-size: 11px;
    font-weight: 700;
}

QLabel#InspectorFieldValue,
QLineEdit#InspectorFieldValue{

    min-height:30px;
    padding:6px 10px;

    font-size:12px;
    color:#E5EDF9;

}

QFrame#InspectorSeparator {
    background-color: rgba(255, 255, 255, 0.08);
    border: none;
    max-height: 1px;
}

QComboBox#InspectorHashCombo {
    min-height: 30px;
    padding: 2px 9px;
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 8px;
    background-color: rgba(255, 255, 255, 0.04);
}

QLabel#InspectorHashValue {
    padding: 9px;
    border-radius: 8px;
    background-color: rgba(0, 0, 0, 0.20);
    font-family: Consolas, monospace;
    font-size: 11px;
    color: #b8c2d0;
}

QPushButton#InspectorCopyButton {
    min-height: 27px;
    padding: 2px 10px;
    border: 1px solid rgba(96, 165, 250, 0.35);
    border-radius: 7px;
    background-color: rgba(59, 130, 246, 0.10);
    color: #93c5fd;
    font-size: 12px;
}

QPushButton#InspectorCopyButton:hover {
    background-color: rgba(59, 130, 246, 0.18);
}

QWidget#HomeInstructionItem {
    background: transparent;
    border: none;
}

QLabel#HomeInstructionNumber {
    background-color: rgba(59, 130, 246, 0.14);
    color: #93c5fd;
    border: 1px solid rgba(59, 130, 246, 0.22);
    border-radius: 8px;
    font-size: 13px;
    font-weight: 800;
}

/* =========================================================
   VESTÍGIOS — HIERARQUIA REFINADA
   ========================================================= */

QLabel#FindingPageTitle {
    font-size: 21px;
    font-weight: 800;
}

QLabel#FindingPageSubtitle {
    font-size: 13px;
    color: #94A3B8;
}


/* INDICADORES CLICÁVEIS */

QPushButton#FindingSummaryButton {
    min-height: 30px;
    padding: 4px 11px;
    border: 1px solid transparent;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 700;
    text-align: center;
}

QPushButton#FindingSummaryButton[summaryType="neutral"] {
    background-color: rgba(148, 163, 184, 0.14);
    color: #CBD5E1;
}

QPushButton#FindingSummaryButton[summaryType="critical"] {
    background-color: rgba(239, 68, 68, 0.14);
    color: #FCA5A5;
}

QPushButton#FindingSummaryButton[summaryType="warning"] {
    background-color: rgba(245, 158, 11, 0.14);
    color: #FCD34D;
}

QPushButton#FindingSummaryButton[summaryType="success"] {
    background-color: rgba(34, 197, 94, 0.14);
    color: #86EFAC;
}

QPushButton#FindingSummaryButton[summaryType="info"] {
    background-color: rgba(59, 130, 246, 0.14);
    color: #93C5FD;
}

QPushButton#FindingSummaryButton:hover {
    border-color: rgba(255, 255, 255, 0.20);
}

QPushButton#FindingSummaryButton:checked {
    border-color: currentColor;
    background-color: rgba(59, 130, 246, 0.22);
}


/* SEÇÕES */

QLabel#InvestigationSectionTitle {
    font-size: 18px;
    font-weight: 800;
}

QLabel#InvestigationSectionCount {
    min-width: 28px;
    min-height: 24px;
    padding: 1px 6px;
    border-radius: 7px;
    background-color: rgba(148, 163, 184, 0.13);
    color: #CBD5E1;
    font-size: 12px;
    font-weight: 700;
}


/* CARDS */

QLabel#FindingTitle {
    font-size: 18px;
    font-weight: 800;
    color: #F8FAFC;
}

QLabel#FindingSeverityLabel {
    font-size: 12px;
    font-weight: 700;
}

QLabel#FindingDescription {
    font-size: 14px;
    color: #D8E1F0;
}

QLabel#FindingSeverityIcon {
    font-size: 19px;
    font-weight: 800;
}

QLabel#EvidenceBadge {
    min-height: 23px;
    padding: 4px 10px;
    border-radius: 7px;
    font-size: 12px;
    font-weight: 700;
}

QLabel#FindingSourceFile,
QLabel#FindingTargetFile {
    min-height: 25px;
    padding: 4px 8px;
    font-size: 12px;
    color: #CBD5E1;
}

QPushButton#FindingDetailsButton {
    min-height: 24px;
    border: none;
    background: transparent;
    padding: 2px 0;
    color: #93C5FD;
    font-size: 12px;
    font-weight: 700;
    text-align: left;
}

QLabel#FindingMetadata {
    padding: 12px;
    border-radius: 8px;
    background-color: #070D18;
    color: #CBD5E1;
    font-family: Consolas, "Courier New", monospace;
    font-size: 12px;
}


/* PAINEL DO ARQUIVO */

QWidget#InspectorInformationBlock {
    background: transparent;
    border: none;
}

QLabel#InspectorFieldTitle {
    min-height: 18px;
    background: transparent;
    color: #94A3B8;
    font-size: 11px;
    font-weight: 700;
}

QLabel#InspectorFieldValue {
    min-height: 30px;
    padding: 5px 8px;
    background-color: rgba(5, 10, 22, 0.48);
    border: 1px solid rgba(148, 163, 184, 0.06);
    border-radius: 6px;
    color: #E2E8F0;
    font-size: 12px;
}

QLabel#InspectorHashValue {
    min-height: 48px;
    padding: 9px;
    border-radius: 8px;
    background-color: rgba(5, 10, 22, 0.62);
    color: #CBD5E1;
    font-family: Consolas, "Courier New", monospace;
    font-size: 11px;
}


/* PROGRESSO FINO */

QFrame#AnalysisProgressContainer {
    background-color: rgba(17, 26, 45, 0.72);
    border: 1px solid #1D2A42;
    border-radius: 8px;
}

QLabel#AnalysisStatusLabel {
    color: #94A3B8;
    font-size: 11px;
}

QProgressBar#AnalysisProgressBar {
    min-height: 4px;
    max-height: 4px;
    border: none;
    border-radius: 2px;
    background-color: #172238;
}

QProgressBar#AnalysisProgressBar::chunk {
    border-radius: 2px;
    background-color: #3B82F6;
}