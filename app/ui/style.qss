}

/* =========================================================
   RESPONSIVIDADE — DIVISOR PRINCIPAL
   ========================================================= */

/*
   Divisor horizontal entre:
   - sidebar;
   - área principal do aplicativo.
*/
QSplitter#MainWindowSplitter {

    /* Mantém o fundo integrado à janela. */
    background: transparent;

    /* Remove qualquer borda externa. */
    border: none;
}


/*
   Área vertical utilizada para arrastar
   a largura entre sidebar e workspace.
*/
QSplitter#MainWindowSplitter::handle {

    /* Define a largura da área arrastável. */
    width: 5px;

    /* Mantém o divisor discreto. */
    background-color: transparent;

    /* Linha sutil que indica a divisão. */
    border-left: 1px solid #1D2A42;
}


/*
   Destaque quando o cursor passa
   sobre o divisor horizontal.
*/
QSplitter#MainWindowSplitter::handle:hover {

    /* Azul translúcido indicando que pode ser arrastado. */
    background-color: rgba(59, 130, 246, 0.10);

    /* Reforça a linha central. */
    border-left-color: #3B82F6;
}


/* =========================================================
   RESPONSIVIDADE — DIVISOR DA SIDEBAR
   ========================================================= */

/*
   Divisor vertical entre:
   - navegador de arquivos;
   - páginas de análise.
*/
QSplitter#SidebarContentSplitter {

    /* Evita criação de outro fundo. */
    background: transparent;

    /* Remove bordas externas. */
    border: none;
}


/*
   Barra horizontal usada para ajustar
   a altura das duas áreas.
*/
QSplitter#SidebarContentSplitter::handle {

    /* Define a altura da região arrastável. */
    height: 7px;

    /* Mantém o fundo transparente. */
    background: transparent;

    /* Linha superior discreta. */
    border-top: 1px solid #26344D;
}


/*
   Destaque da barra ao passar o mouse.
*/
QSplitter#SidebarContentSplitter::handle:hover {

    /* Fundo azul muito suave. */
    background-color: rgba(59, 130, 246, 0.06);

    /* Linha azul indicando interação. */
    border-top-color: #3B82F6;
}


/* =========================================================
   SIDEBAR RESPONSIVA
   ========================================================= */

/*
   A largura não é mais limitada pelo QSS.

   O tamanho será controlado pelo QSplitter
   e pelo mínimo definido no código Python.
*/
QFrame#Sidebar {

    /* Fundo principal da sidebar. */
    background-color: #070D1D;

    /* Linha de separação da área principal. */
    border-right: 1px solid #1D2A42;
}


/* =========================================================
   HASH — BOTÃO DE AJUSTE DAS COLUNAS
   ========================================================= */

/*
   Botão que restaura a distribuição
   automática das colunas.
*/
QPushButton#HashResetColumnsButton {

    /* Altura compacta. */
    min-height: 31px;

    /* Espaçamento interno horizontal. */
    padding: 0 11px;

    /* Fundo transparente no estado padrão. */
    background: transparent;

    /* Borda discreta. */
    border: 1px solid #293850;

    /* Arredondamento. */
    border-radius: 7px;

    /* Cor do texto. */
    color: #94A3B8;

    /* Tamanho da fonte. */
    font-size: 11px;

    /* Peso da fonte. */
    font-weight: 700;

    /* Centraliza o texto do botão. */
    text-align: center;
}


/*
   Botão quando o cursor passa sobre ele.
*/
QPushButton#HashResetColumnsButton:hover {

    /* Fundo azul suave. */
    background-color: rgba(59, 130, 246, 0.10);

    /* Borda azul. */
    border-color: #3B82F6;

    /* Texto branco. */
    color: #FFFFFF;
}


/*
   Botão durante o clique.
*/
QPushButton#HashResetColumnsButton:pressed {

    /* Fundo um pouco mais intenso. */
    background-color: rgba(37, 99, 235, 0.20);

    /* Borda azul clara. */
    border-color: #60A5FA;
}

