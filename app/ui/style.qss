/* =========================================================
   FORENSIHASH PRO - CLEAN DARK THEME
   Versão limpa para substituir o QSS antigo
   ========================================================= */

/* =========================
   GLOBAL
   ========================= */
QWidget {
    background-color: #0B1120;
    color: #E5E7EB;
    font-family: "Segoe UI", "Inter", "Arial";
    font-size: 13px;
}

QLabel {
    background: transparent;
}

#Content,
QWidget#TimelinePage {
    background-color: #0B1120;
}

#PageTitle {
    font-size: 25px;
    font-weight: 900;
    color: #F8FAFC;
}

#SectionTitle {
    font-size: 20px;
    font-weight: 900;
    color: #F8FAFC;
}

#SectionSubtitle {
    font-size: 13px;
    color: #94A3B8;
}

#ClockLabel {
    color: #60A5FA;
    font-size: 12px;
    font-weight: 600;
}

/* =========================
   SIDEBAR
   ========================= */
#Sidebar {
    background-color: #020617;
    border-right: 1px solid #1E293B;
}

#SidebarTitle {
    font-size: 26px;
    font-weight: 900;
    color: #F8FAFC;
}

#SidebarSubtitle {
    font-size: 11px;
    font-weight: 800;
    color: #38BDF8;
    letter-spacing: 3px;
}

#SidebarSectionTitle {
    color: #64748B;
    font-size: 11px;
    font-weight: 800;
}

/* =========================
   BUTTONS
   ========================= */
QPushButton {
    background-color: #0F172A;
    color: #CBD5E1;
    border: 1px solid #1E293B;
    border-radius: 12px;
    padding: 11px 14px;
    text-align: left;
    font-weight: 700;
}

QPushButton:hover {
    background-color: #172554;
    color: #FFFFFF;
    border-color: #2563EB;
}

QPushButton:pressed {
    background-color: #1D4ED8;
    border-color: #60A5FA;
}

/* =========================
   TABS
   ========================= */
QTabWidget::pane {
    border: 1px solid #1E293B;
    border-radius: 18px;
    background-color: #0F172A;
    top: -1px;
}

QTabBar::tab {
    background-color: #0F172A;
    color: #94A3B8;
    border: 1px solid #1E293B;
    padding: 11px 18px;
    margin-right: 5px;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    font-weight: 700;
}

QTabBar::tab:selected {
    background-color: #2563EB;
    color: #FFFFFF;
    border-color: #60A5FA;
}

QTabBar::tab:hover:selected {
    background-color: #172554;
    color: #E0F2FE;
}

/* QTabBar::tab:hover:!selected {
    background-color: #172554;
    color: #E0F2FE;
} */

/* =========================
   BASE CARDS
   ========================= */
#BaseCard,
#InfoCard,
#summaryCard,
#metadataCard,
#findingsPreviewCard {
    background-color: #111827;
    border: 1px solid #243244;
    border-radius: 18px;
    padding: 16px;
}

#BaseCard:hover,
#InfoCard:hover,
#summaryCard:hover,
#metadataCard:hover,
#findingsPreviewCard:hover {
    border-color: #334155;
}

#CardTitle,
#DashboardTitle,
#summaryTitle,
#metadataCardTitle,
#findingsPreviewTitle {
    color: #F8FAFC;
    font-weight: 900;
}

#CardContent,
#summaryText,
#metadataHighlightText,
#metadataInsightText,
#findingsPreviewText {
    color: #CBD5E1;
}

/* =========================
   LISTS / TABLES
   ========================= */
QListWidget,
QTableWidget {
    background-color: #0F172A;
    color: #E5E7EB;
    border: 1px solid #1E293B;
    border-radius: 14px;
    padding: 8px;
    gridline-color: #1E293B;
    selection-background-color: #2563EB;
    selection-color: #FFFFFF;
}

QListWidget::item {
    padding: 8px;
    border-radius: 8px;
}

QListWidget::item:hover {
    background-color: #1E293B;
}

QListWidget::item:selected {
    background-color: #2563EB;
    color: #FFFFFF;
}

QTableWidget::item {
    padding: 8px;
}

QTableWidget::item:hover {
    background-color: #1E293B;
}

QHeaderView::section {
    background-color: #111827;
    color: #F8FAFC;
    border: none;
    padding: 9px;
    font-weight: 800;
}

/* =========================
   INPUTS
   ========================= */
QLineEdit,
QDateTimeEdit,
QComboBox,
#HashSelector {
    background-color: #0B1220;
    color: #E5E7EB;
    border: 1px solid #1E293B;
    border-radius: 10px;
    padding: 8px 12px;
}

QLineEdit:focus,
QDateTimeEdit:focus,
QComboBox:hover,
#HashSelector:hover {
    border-color: #38BDF8;
}

QLineEdit::placeholder {
    color: #64748B;
}

/* =========================
   SCROLL
   ========================= */
QScrollArea,
#MainScrollArea,
#FindingScrollArea,
#TimelineScroll {
    border: none;
    background: transparent;
}

QScrollBar:vertical {
    background: #0F172A;
    width: 12px;
    margin: 4px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background: #334155;
    min-height: 40px;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background: #475569;
}

QScrollBar:horizontal {
    background: #0F172A;
    height: 12px;
    margin: 4px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background: #334155;
    min-width: 40px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal:hover {
    background: #475569;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0px;
    height: 0px;
}

/* =========================
   SMART TIMELINE
   ========================= */
QWidget#SmartTimeline {
    background-color: #0F172A;
    border: 1px solid #243244;
    border-radius: 16px;
    min-height: 155px;
}

QFrame#SmartTimelineTrack {
    background-color: #334155;
    border: none;
    margin-left: 45px;
    margin-right: 45px;
}

QWidget#TimelineNode {
    background: transparent;
}

QLabel#TimelineNodeDot {
    font-size: 18px;
    font-weight: 900;
}

QFrame#TimelineNodeLine {
    background-color: #475569;
    border: none;
    min-width: 2px;
    max-width: 2px;
}

QLabel#TimelineNodeTitle {
    color: #F8FAFC;
    font-size: 12px;
    font-weight: 800;
}

QLabel#TimelineNodeDate {
    color: #BFDBFE;
    font-size: 11px;
    font-weight: 600;
}

/* =========================
   TECHNICAL TIMELINE CARDS
   ========================= */
QWidget#TechnicalTimeline {
    background: transparent;
}

QFrame#TimelineEventCard {
    background-color: #111827;
    border: 1px solid #243244;
    border-radius: 16px;
    min-height: 190px;
}

QFrame#TimelineEventCard:hover {
    background-color: #162033;
    border-color: #3B82F6;
}

QLabel#TimelineCardDot {
    font-size: 22px;
    font-weight: 900;
}

QLabel#TimelineCardTitle {
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 800;
}

QLabel#TimelineCardDate {
    color: #BFDBFE;
    font-size: 12px;
    font-weight: 600;
}

QLabel#TimelineCardSource {
    color: #DBEAFE;
    background-color: #0B1222;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 5px 8px;
    font-size: 11px;
}

QLabel#TimelineCardDescription {
    color: #CBD5E1;
    font-size: 12px;
}

QLabel#TimelineResult {
    color: #FBBF24;
    background-color: rgba(251, 146, 60, 0.10);
    border: 1px solid rgba(251, 146, 60, 0.35);
    border-radius: 12px;
    padding: 12px;
    font-size: 12px;
}

/* =========================
   CONTRACT DATE CONFIRMATION
   ========================= */
QFrame#ContractDateConfirmationCard {
    background-color: #111C33;
    border: 1px solid #F59E0B;
    border-radius: 14px;
}

QLabel#ContractDateTitle {
    color: #FBBF24;
    font-size: 15px;
    font-weight: 800;
}

QLabel#ContractDateMessage {
    color: #CBD5E1;
    font-size: 13px;
}

/* =========================
   SUMMARY / PROGRESS
   ========================= */
QProgressBar {
    background-color: #1E293B;
    border: none;
    border-radius: 6px;
    color: #F8FAFC;
    text-align: center;
    height: 22px;
    font-weight: 800;
}

QProgressBar::chunk {
    background-color: #2563EB;
    border-radius: 6px;
}

#summaryScoreOk {
    color: #86EFAC;
    font-weight: 900;
}

#summaryScoreWarning {
    color: #FDE68A;
    font-weight: 900;
}

#summaryScoreDanger {
    color: #FDA4AF;
    font-weight: 900;
}

#summaryProgressOk::chunk {
    background-color: #22C55E;
}

#summaryProgressWarning::chunk {
    background-color: #EAB308;
}

#summaryProgressDanger::chunk {
    background-color: #EF4444;
}

/* =========================
   BADGES
   ========================= */
#badge_ok,
#findingBadge_success {
    background-color: rgba(34, 197, 94, 0.14);
    color: #86EFAC;
    border: 1px solid rgba(34, 197, 94, 0.34);
    border-radius: 14px;
    padding: 5px 11px;
    font-weight: 800;
}

#badge_warning,
#findingBadge_warning {
    background-color: rgba(234, 179, 8, 0.14);
    color: #FDE68A;
    border: 1px solid rgba(234, 179, 8, 0.35);
    border-radius: 14px;
    padding: 5px 11px;
    font-weight: 800;
}

#badge_danger,
#findingBadge_critical {
    background-color: rgba(239, 68, 68, 0.14);
    color: #FCA5A5;
    border: 1px solid rgba(239, 68, 68, 0.35);
    border-radius: 14px;
    padding: 5px 11px;
    font-weight: 800;
}

#badge_info,
#findingBadge_info {
    background-color: rgba(59, 130, 246, 0.14);
    color: #93C5FD;
    border: 1px solid rgba(59, 130, 246, 0.35);
    border-radius: 14px;
    padding: 5px 11px;
    font-weight: 800;
}

#badge_neutral {
    background-color: rgba(148, 163, 184, 0.12);
    color: #CBD5E1;
    border: 1px solid rgba(148, 163, 184, 0.25);
    border-radius: 14px;
    padding: 5px 11px;
    font-weight: 800;
}

/* =========================
   METADATA / FINDINGS
   ========================= */
#metadataCountLabel,
#findingsPreviewSubtitle,
#findingsPreviewMuted,
#FindingSubtitle,
#FindingEmptyText,
#findingItemMuted {
    color: #94A3B8;
    font-size: 12px;
}

#metadataHighlightsBox {
    background-color: #0B1220;
    border: 1px solid #1E293B;
    border-radius: 14px;
}

#metadataInsightBox,
#expertNoteBox {
    background-color: rgba(56, 189, 248, 0.08);
    border-left: 4px solid #38BDF8;
    border-radius: 12px;
}

#metadataInsightTitle,
#expertNoteTitle {
    color: #E0F2FE;
    font-size: 14px;
    font-weight: 900;
}

#expertNoteText {
    color: #CBD5E1;
    font-size: 13px;
}

#findingItemInfo,
#findingItemWarning,
#findingItemCritical,
#findingItemSuccess {
    background-color: #111827;
    border-radius: 16px;
    padding: 10px;
}

#findingItemInfo {
    border: 1px solid rgba(59, 130, 246, 0.35);
}

#findingItemWarning {
    border: 1px solid rgba(234, 179, 8, 0.42);
}

#findingItemCritical {
    border: 1px solid rgba(239, 68, 68, 0.48);
}

#findingItemSuccess {
    border: 1px solid rgba(34, 197, 94, 0.38);
}

#findingItemTitle {
    color: #F8FAFC;
    font-size: 15px;
    font-weight: 900;
}

#findingItemText {
    color: #CBD5E1;
    font-size: 13px;
}

/* =========================
   OCR
   ========================= */
#PdfViewer,
#OcrTextViewer {
    background-color: #111827;
    border: 1px solid #243244;
    border-radius: 18px;
    padding: 10px;
}

#PdfPageImage {
    background-color: #F8FAFC;
    border: 1px solid #334155;
    border-radius: 10px;
    margin-bottom: 14px;
}

#OcrTextArea {
    background-color: #0B1220;
    color: #CBD5E1;
    border: 1px solid #1E293B;
    border-radius: 12px;
    padding: 12px;
    font-family: Consolas, "Courier New", monospace;
    font-size: 12px;
    selection-background-color: #2563EB;
    selection-color: #FFFFFF;
}

/* =========================
   HASH PAGE
   ========================= */
#HashTable {
    background-color: #0B1220;
    color: #CBD5E1;
    border: 1px solid #243244;
    border-radius: 14px;
    gridline-color: #1E293B;
    selection-background-color: #2563EB;
    selection-color: #FFFFFF;
    font-family: Consolas, "Courier New", monospace;
    font-size: 12px;
}

#HashTable::item {
    padding: 8px;
}

/* ========================
   TIMELINE PAGE
   ======================== */
#TimelinePage {
    background-color: #07111f;
}

#TimelinePageTitle {
    color: #f8fafc;
    font-size: 20px;
    font-weight: 700;
}

#TimelinePageSubtitle {
    color: #cbd5e1;
    font-size: 13px;
}

#TechnicalTimeline {
    background-color: transparent;
}

#TimelineFilterButton {
    background-color: #101827;
    color: #cbd5e1;
    border: 1px solid #25324a;
    border-radius: 8px;
    padding: 8px 14px;
    font-size: 13px;
}

#TimelineFilterButton:checked {
    background-color: #2563eb;
    color: #ffffff;
    border: 1px solid #3b82f6;
}

#TimelineScroll {
    background-color: #0b1320;
    border: 1px solid #1e293b;
    border-radius: 10px;
}

#TimelineScroll > QWidget > QWidget {
    background-color: transparent;
}

#TimelineListContainer {
    background-color: transparent;
}

#TimelineEventRow {
    background-color: rgba(15, 23, 42, 0.84);
    border-bottom: 1px solid #1e293b;
    min-height: 50px;
}

#TimelineTimeBox {
    min-width: 105px;
    max-width: 105px;
    background-color: transparent;
}

#TimelineDateLabel {
    color: #cbd5e1;
    font-size: 13px;
}

#TimelineHourLabel {
    color: #38bdf8;
    font-size: 13px;
    font-weight: 700;
}

#TimelineMarker {
    background-color: transparent;
}

#TimelineVerticalLine {
    background-color: #334155;
}

#TimelineDot {
    border-radius: 14px;
    color: white;
    font-size: 13px;
    font-weight: 700;
    background-color: #64748b;
}

#TimelineDot[eventType="creation"] {
    background-color: #22c55e;
}

#TimelineDot[eventType="modification"] {
    background-color: #f59e0b;
}

#TimelineDot[eventType="signature"] {
    background-color: #2563eb;
}

#TimelineDot[eventType="access"] {
    background-color: #8b5cf6;
}

#TimelineDot[eventType="system"] {
    background-color: #94a3b8;
}

#TimelineContentBox {
    background-color: transparent;
}

#TimelineEventTitle {
    color: #f8fafc;
    font-size: 13px;
    font-weight: 700;
}

#TimelineEventDescription {
    color: #cbd5e1;
    font-size: 12px;
}

#TimelineEventDetails {
    color: #94a3b8;
    font-size: 13px;
}

#TimelineRightBox {
    min-width: 150px;
    max-width: 190px;
    background-color: transparent;
}

#TimelineBadge {
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 12px;
    font-weight: 700;
    color: #e2e8f0;
    border: 1px solid #475569;
}

#TimelineBadge[eventType="creation"] {
    color: #86efac;
    border-color: #22c55e;
}

#TimelineBadge[eventType="modification"] {
    color: #fde68a;
    border-color: #f59e0b;
}

#TimelineBadge[eventType="signature"] {
    color: #93c5fd;
    border-color: #2563eb;
}

#TimelineBadge[eventType="access"] {
    color: #c4b5fd;
    border-color: #8b5cf6;
}

#TimelineBadge[eventType="system"] {
    color: #cbd5e1;
    border-color: #64748b;
}

#TimelineSource {
    color: #94a3b8;
    font-size: 12px;
}

#TimelineFooter {
    color: #cbd5e1;
    font-size: 12px;
    padding-left: 8px;
}

#TimelineEmpty {
    color: #94a3b8;
    padding: 60px;
    font-size: 14px;
}

#TimelineSidePanel {
    background-color: transparent;
    min-width: 310px;
    max-width: 390px;
}

#TimelineInfoCard {
    background-color: #0b1320;
    border: 1px solid #1e293b;
    border-radius: 10px;
}

#TimelineInfoTitle {
    color: #f8fafc;
    font-size: 14px;
    font-weight: 700;
}

#TimelineInfoContent {
    color: #cbd5e1;
    font-size: 13px;
    line-height: 1.5em;
}

/* ========================
   TIMELINE CARDS
   ======================== */

#TimelineEventCard {
    background-color: #101827;
    border: 1px solid #1e293b;
    border-radius: 10px;
    margin-top: 3px;
    margin-bottom: 3px;
}

#TimelineEventCard[eventType="creation"] {
    border-left: 4px solid #22c55e;
}

#TimelineEventCard[eventType="modification"] {
    border-left: 4px solid #f59e0b;
}

#TimelineEventCard[eventType="signature"] {
    border-left: 4px solid #2563eb;
}

#TimelineEventCard[eventType="access"] {
    border-left: 4px solid #8b5cf6;
}

#TimelineEventCard[eventType="system"] {
    border-left: 4px solid #94a3b8;
}

#TimelineEventIcon {
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
    border-radius: 14px;
    background-color: #172033;
    color: #e2e8f0;
    font-size: 13px;
}

#TimelineHourBadge {
    background-color: #101827;
    color: #38bdf8;
    border: 1px solid #1e40af;
    border-radius: 8px;
    padding: 5px 8px;
    font-size: 12px;
    font-weight: 700;
}

#TimelineMiniStat {
    background-color: #101827;
    border: 1px solid #1e293b;
    border-radius: 10px;
}

#TimelineMiniStatValue {
    color: #f8fafc;
    font-size: 20px;
    font-weight: 800;
}

#TimelineMiniStatLabel {
    color: #94a3b8;
    font-size: 11px;
}